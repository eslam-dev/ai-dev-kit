#!/usr/bin/env python3
"""Completion gate: the checks a change must pass before it counts as done.

Two sources, deliberately separated:

  index checks  — answered from `.ai/project-index/` alone. No PHP, no project
                  execution, no new parsing. These are the rules the kit has
                  always stated but never verified.
  project gates — the project's own `composer.json` scripts (test, analyse,
                  lint), run in that order, exactly as 12-php-tooling/
                  00-quality-gates.mdc prescribes. Skipped, never faked, when
                  the tool is absent. Opt-in via `--gates`: a default that ran
                  a test suite would make this unusable from a Stop hook.

Exit codes: 0 clean, 1 blocking findings, 2 could not run (no index, bad index).
"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

SEVERITY_ORDER = {"blocking": 0, "warning": 1}
GATE_ORDER = ["test", "analyse", "lint"]
# Aliases projects actually use for the same three gates.
GATE_ALIASES = {
    "test": ["test", "tests", "pest", "phpunit"],
    "analyse": ["analyse", "analyze", "stan", "phpstan", "psalm"],
    "lint": ["lint", "format", "pint", "cs", "style"],
}


def load_records(root: Path) -> list[dict]:
    path = root / ".ai/project-index/SYMBOLS.jsonl"
    if not path.exists():
        print(f"cannot verify: no index at {path} — run `ai-dev .` first")
        sys.exit(2)
    records = []
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            if not line.strip():
                continue
            rec = json.loads(line)
            if "path" in rec:
                records.append(rec)
    except Exception as exc:
        print(f"cannot verify: unreadable index ({exc}) — rerun `ai-dev . --full`")
        sys.exit(2)
    return records


def stack_of(root: Path) -> dict:
    try:
        data = json.loads((root / ".ai/project-index/manifest.json").read_text(encoding="utf-8"))
        return data.get("stack") or {}
    except Exception:
        return {}


# ---------------------------------------------------------------------------
# Index checks. Each returns a list of (severity, path, message).
# Every check is conservative: it only fires on evidence present in the index,
# never on the absence of a file the indexer may simply not have parsed.
# ---------------------------------------------------------------------------

def check_wp_rest(records: list[dict], stack: dict) -> list[tuple]:
    """WordPress REST routes registered without a permission_callback.

    The indexer has flagged these since 1.3 but only ever printed them into
    HOOKS.md. Here they become blocking.
    """
    if not stack.get("wordpress"):
        return []
    out = []
    for rec in records:
        for route in rec.get("routes", []):
            if route.get("method") == "REST" and "NO permission_callback" in route.get("handler", ""):
                out.append(("blocking", rec["path"],
                            f"REST route `{route.get('uri')}` has no permission_callback — publicly callable"))
    return out


def check_migration_down(root: Path, records: list[dict]) -> list[tuple]:
    """Migrations whose down() is missing or empty.

    Uses the `line`/`end` range the indexer already brace-matched for the symbol
    — re-deriving it with a regex here would run past the method and match the
    class's closing brace instead.
    """
    out = []
    for rec in records:
        if rec.get("responsibility") != "migr" or not rec.get("schema"):
            continue
        down = next((s for s in rec.get("symbols", [])
                     if s.get("kind") == "function" and s.get("name") == "down"), None)
        if down is None:
            out.append(("blocking", rec["path"], "migration has no down() — not reversible"))
            continue
        start, end = down.get("line"), down.get("end")
        if not start or not end:
            continue
        try:
            lines = (root / rec["path"]).read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        body = "\n".join(lines[start - 1:end])
        open_brace, close_brace = body.find("{"), body.rfind("}")
        if open_brace != -1 and close_brace > open_brace and not body[open_brace + 1:close_brace].strip():
            out.append(("blocking", rec["path"], "migration has an empty down() — not reversible"))
    return out


def check_mass_assignment(root: Path, records: list[dict], stack: dict) -> list[tuple]:
    """Eloquent models that declare neither $fillable nor $guarded."""
    if not stack.get("laravel"):
        return []
    out = []
    for rec in records:
        if rec.get("responsibility") != "model":
            continue
        props = {s["name"] for s in rec.get("symbols", []) if s.get("kind") == "prop"}
        if props & {"fillable", "guarded"}:
            continue
        # Only flag files that really are Eloquent models.
        if rec.get("extends") not in {"Model", "Authenticatable", "Pivot"}:
            continue
        out.append(("blocking", rec["path"],
                    "Eloquent model declares neither $fillable nor $guarded — mass assignment is open"))
    return out


def check_strict_mode(root: Path, records: list[dict], stack: dict) -> list[tuple]:
    """Laravel strict mode absent — the runtime guard that makes N+1 a test failure.

    Warning, never blocking: enabling it on an existing codebase surfaces every
    latent violation at once and that has to be a deliberate, staged decision.
    """
    major = stack.get("laravel_version")
    if not stack.get("laravel") or not major or major < 9:
        return []
    for rec in records:
        if rec.get("responsibility") != "provider":
            continue
        try:
            text = (root / rec["path"]).read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if "shouldBeStrict" in text or "preventLazyLoading" in text:
            return []
    return [("warning", "app/Providers/AppServiceProvider.php",
             "Model::shouldBeStrict() not enabled — lazy loading (N+1) cannot fail a test. "
             "Run the `harden-runtime` skill to stage it.")]


def run_index_checks(root: Path, records: list[dict], stack: dict) -> list[tuple]:
    findings: list[tuple] = []
    findings += check_wp_rest(records, stack)
    findings += check_migration_down(root, records)
    findings += check_mass_assignment(root, records, stack)
    findings += check_strict_mode(root, records, stack)
    findings.sort(key=lambda f: (SEVERITY_ORDER.get(f[0], 9), f[1]))
    return findings


# ---------------------------------------------------------------------------
# Project gates
# ---------------------------------------------------------------------------

def resolve_gates(root: Path) -> dict[str, str]:
    """Map test/analyse/lint to the project's own composer script names."""
    try:
        scripts = json.loads((root / "composer.json").read_text(encoding="utf-8")).get("scripts") or {}
    except Exception:
        return {}
    resolved = {}
    for gate in GATE_ORDER:
        for alias in GATE_ALIASES[gate]:
            if alias in scripts:
                resolved[gate] = alias
                break
    return resolved


def run_gates(root: Path, gates: dict[str, str]) -> tuple[list[str], list[str], list[str]]:
    passed, failed, skipped = [], [], []
    if not shutil.which("composer"):
        return passed, failed, [f"{g} (composer not installed)" for g in GATE_ORDER]
    for gate in GATE_ORDER:
        script = gates.get(gate)
        if not script:
            skipped.append(f"{gate} (no composer script)")
            continue
        proc = subprocess.run(["composer", "run", "--", script],
                              cwd=root, capture_output=True, text=True)
        if proc.returncode == 0:
            passed.append(f"{gate} (composer {script})")
        else:
            tail = (proc.stdout + proc.stderr).strip().splitlines()[-8:]
            failed.append(f"{gate} (composer {script})\n    " + "\n    ".join(tail))
    return passed, failed, skipped



# ---------------------------------------------------------------------------
# Opt-in Claude Code hook
# ---------------------------------------------------------------------------

# Claude Code's hook protocol uses exit 2 to BLOCK, while verify uses 2 for
# "could not run". Passing the status through verbatim would invert the
# contract and trap an agent whenever the index is missing, so the hook is a
# translating wrapper: verify 1 -> hook 2 (block), everything else -> 0.
HOOK_COMMAND = (
    'ai-dev verify 1>&2; rc=$?; '
    '[ "$rc" -eq 1 ] && exit 2; exit 0'
)


def install_hook(root: Path) -> int:
    """Merge a Stop hook into .claude/settings.json, preserving what is there.

    Never called from `ai-dev .` — installing this silently would change how
    every session in the repo terminates.
    """
    path = root / ".claude/settings.json"
    settings: dict = {}
    if path.exists():
        try:
            settings = json.loads(path.read_text(encoding="utf-8"))
        except Exception as exc:
            print(f"cannot install hook: {path} is not valid JSON ({exc})")
            return 2
    hooks = settings.setdefault("hooks", {})
    stop = hooks.setdefault("Stop", [])
    for entry in stop:
        for h in entry.get("hooks", []):
            if "ai-dev verify" in h.get("command", ""):
                print(f"hook already installed in {path}")
                return 0
    stop.append({"hooks": [{"type": "command", "command": HOOK_COMMAND}]})
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    print(f"installed Stop hook in {path}")
    print("  Claude Code will now block task completion on a blocking finding.")
    print("  Other editors: the always-on rule asks for `ai-dev verify`, but cannot enforce it.")
    return 0


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("project", nargs="?", default=".")
    ap.add_argument("--gates", action="store_true",
                    help="also run the project's composer test/analyse/lint scripts (slow, executes code)")
    ap.add_argument("--json", action="store_true", dest="as_json")
    ap.add_argument("--install-hook", action="store_true",
                    help="merge a blocking Stop hook into .claude/settings.json (Claude Code only)")
    args = ap.parse_args()

    root = Path(args.project).resolve()
    if args.install_hook:
        sys.exit(install_hook(root))
    records = load_records(root)
    stack = stack_of(root)

    findings = run_index_checks(root, records, stack)
    gates_passed: list[str] = []
    gates_failed: list[str] = []
    gates_skipped: list[str] = []
    if args.gates:
        gates_passed, gates_failed, gates_skipped = run_gates(root, resolve_gates(root))

    blocking = [f for f in findings if f[0] == "blocking"]
    warnings = [f for f in findings if f[0] == "warning"]
    ok = not blocking and not gates_failed

    if args.as_json:
        print(json.dumps({
            "ok": ok,
            "findings": [{"severity": s, "path": p, "message": m} for s, p, m in findings],
            "gates": {"passed": gates_passed, "failed": gates_failed, "skipped": gates_skipped},
        }, indent=1))
        sys.exit(0 if ok else 1)

    if blocking:
        print(f"BLOCKING ({len(blocking)}):")
        for _, path, msg in blocking:
            print(f"  {path}: {msg}")
    if warnings:
        print(f"warnings ({len(warnings)}):")
        for _, path, msg in warnings:
            print(f"  {path}: {msg}")
    if args.gates:
        for line in gates_passed:
            print(f"  gate ok: {line}")
        for line in gates_skipped:
            print(f"  gate skipped: {line}")
        for line in gates_failed:
            print(f"  GATE FAILED: {line}")

    if ok:
        if args.gates:
            print("verify: clean (index checks + project gates)")
        else:
            gates = resolve_gates(root)
            owed = ", ".join(f"composer {gates[g]}" for g in GATE_ORDER if g in gates)
            print("verify: clean (index checks)"
                  + (f" — still owed: {owed} (rerun with --gates)" if owed else ""))
        sys.exit(0)
    print(f"verify: {len(blocking)} blocking finding(s), {len(gates_failed)} failed gate(s)")
    sys.exit(1)


if __name__ == "__main__":
    main()
