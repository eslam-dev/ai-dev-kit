#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
from collections import defaultdict
from pathlib import Path
from typing import Any

VERSION = "1.2.0"
IGNORE_PREFIXES = (
    ".git/", ".idea/", ".vscode/", "vendor/", "node_modules/", "storage/",
    "bootstrap/cache/", "public/build/", "dist/", "build/", "coverage/",
    ".next/", ".nuxt/", ".cache/", ".ai/project-index/",
    # WordPress core (vendored like any other framework core, not the project's own code),
    # the WooCommerce core plugin (third-party, thousands of files), and generated/
    # user-uploaded content.
    "wp-admin/", "wp-includes/", "wp-content/uploads/", "wp-content/cache/", "wp-content/upgrade/",
    "wp-content/plugins/woocommerce/",
)
SOURCE_SUFFIXES = {
    ".php", ".js", ".jsx", ".ts", ".tsx", ".vue", ".py", ".go", ".java",
    ".kt", ".rb", ".rs", ".cs", ".sql", ".graphql", ".gql",
}
SPECIAL_FILES = {
    "composer.json", "package.json", "vite.config.js", "vite.config.ts",
    "phpunit.xml", "phpunit.xml.dist", "artisan",
}
PHP_DECL = re.compile(
    r"(?m)^\s*(?:final\s+|abstract\s+|readonly\s+)?"
    r"(?:(?P<kind>class|interface|trait|enum)\s+(?P<type>[A-Za-z_][A-Za-z0-9_]*)"
    r"|(?:(?:public|protected|private|static|final|abstract|readonly)\s+)*"
    r"function\s+(?P<func>[A-Za-z_][A-Za-z0-9_]*)\s*\()"
)
JS_DECL = re.compile(
    r"(?m)^\s*(?:export\s+(?:default\s+)?)?(?:async\s+)?function\s+(?P<func>[A-Za-z_$][\w$]*)\s*\("
    r"|^\s*(?:export\s+)?(?:const|let|var)\s+(?P<const>[A-Za-z_$][\w$]*)\s*="
    r"|^\s*(?:export\s+(?:default\s+)?)?class\s+(?P<class>[A-Za-z_$][\w$]*)"
)
PHP_NAMESPACE = re.compile(r"(?m)^\s*namespace\s+([^;]+);")
PHP_USE = re.compile(r"(?m)^\s*use\s+([^;]+);")
JS_IMPORT = re.compile(r"(?m)^\s*import\s+.*?\s+from\s+['\"]([^'\"]+)['\"]")
ROUTE = re.compile(
    r"Route::(?P<verb>get|post|put|patch|delete|options|any|match|resource|apiResource)"
    r"\s*\(\s*(?P<body>[^;\n]+)"
)
ROUTE_STRING = re.compile(r"['\"]([^'\"]*)['\"]")
ROUTE_CLASS_HANDLER = re.compile(r"([A-Za-z_][\w\\]*)::class(?:\s*,\s*['\"](\w+)['\"])?")
ROUTE_AT_HANDLER = re.compile(r"['\"]([\w\\]+@\w+)['\"]")
HTTP_VERBS = {"get", "post", "put", "patch", "delete", "options", "head", "any"}
RELATION = re.compile(
    r"return\s+\$this->(?P<kind>hasOne|hasMany|belongsTo|belongsToMany|morphOne|morphMany|morphTo|morphToMany|hasOneThrough|hasManyThrough)"
    r"\s*\(\s*(?P<target>[^,\)]+)"
)
HOOK = re.compile(
    r"(?P<verb>add_action|add_filter|do_action|apply_filters|add_shortcode|register_rest_route)"
    r"\s*\(\s*(?P<body>[^;\n]+)"
)
TABLE = re.compile(r"(?:Schema::(?:create|table)|protected\s+\$table\s*=)\s*\(?\s*['\"]([^'\"]+)['\"]")

# (path token, short code, human label) — codes keep the generated tables small;
# the full legend is emitted once in PROJECT_MAP.md.
RESPONSIBILITIES = [
    ("routes/", "routes", "Application route definitions"),
    # These resources/* checks must come before the generic "resource" check
    # below, since "resource" is a substring of "resources" and would
    # otherwise shadow every one of them.
    ("resources/js/pages", "page", "Inertia/React page"),
    ("resources/js/components", "comp", "React component"),
    ("resources/js/hooks", "hook", "React hook"),
    ("resources/views", "view", "Blade view / server-rendered page"),
    ("controller", "ctrl", "HTTP controller / entry point"),
    ("request", "req", "Validation and request authorization"),
    ("policy", "policy", "Resource authorization"),
    ("middleware", "mw", "HTTP middleware"),
    ("resource", "apires", "API/data transformation"),
    ("model", "model", "Persistence model"),
    ("migration", "migr", "Database schema migration"),
    ("service", "svc", "Application/domain service"),
    ("action", "action", "Single-purpose application action"),
    ("handler", "handler", "Application/domain handler"),
    ("job", "job", "Queued/background job"),
    ("event", "event", "Application/domain event"),
    ("listener", "listen", "Event listener"),
    ("observer", "observe", "Model lifecycle observer"),
    ("command", "cmd", "Console command"),
    ("test", "test", "Automated test"),
    # Kept narrow (full path segments, not bare words like "admin"/"template")
    # to avoid mislabeling unrelated non-WordPress files.
    ("wp-content/mu-plugins", "wp-mu", "WordPress must-use plugin"),
    ("wp-content/plugins", "wp-plugin", "WordPress plugin"),
    ("wp-content/themes", "wp-theme", "WordPress theme"),
    ("woocommerce", "woo", "WooCommerce extension/customization"),
    ("shortcode", "shortcode", "WordPress shortcode handler"),
]
DEFAULT_RESPONSIBILITY = ("src", "Project source or configuration")
LEGEND = {code: label for _, code, label in RESPONSIBILITIES}
LEGEND[DEFAULT_RESPONSIBILITY[0]] = DEFAULT_RESPONSIBILITY[1]
# Order used to pick the "key files" shown per domain in PROJECT_MAP.md.
KEY_FILE_PRIORITY = [
    "ctrl", "model", "svc", "routes", "page", "view", "policy", "action",
    "handler", "job", "apires", "req",
    "wp-plugin", "wp-theme", "wp-mu", "shortcode", "woo",
]

def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def is_ignored(rel: str) -> bool:
    rel = rel.replace("\\", "/")
    return any(rel == p.rstrip("/") or rel.startswith(p) for p in IGNORE_PREFIXES)

def discover(root: Path) -> list[Path]:
    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = Path(dirpath).relative_to(root).as_posix()
        rel_dir = "" if rel_dir == "." else rel_dir
        # Prune ignored directories in place so os.walk never descends into
        # vendor/, node_modules/, .git/, etc. instead of filtering after a
        # full recursive walk.
        dirnames[:] = [
            d for d in dirnames
            if not is_ignored(f"{rel_dir}/{d}" if rel_dir else d)
        ]
        for name in filenames:
            rel = f"{rel_dir}/{name}" if rel_dir else name
            if is_ignored(rel):
                continue
            if Path(name).suffix.lower() in SOURCE_SUFFIXES or name in SPECIAL_FILES or rel.startswith("routes/"):
                files.append(Path(dirpath) / name)
    return sorted(files)

def domain_of(rel: str) -> str:
    parts = Path(rel).parts
    if rel.startswith("app/"):
        if len(parts) >= 4 and parts[1] in {"Domain", "Domains", "Modules"}:
            return parts[2]
        return parts[1] if len(parts) > 1 else "Application"
    if rel.startswith("resources/js/"):
        if len(parts) >= 4 and parts[2].lower() in {"pages", "features", "modules"}:
            return parts[3]
        return "Frontend"
    if rel.startswith("resources/views/"):
        if len(parts) >= 3 and parts[2].lower() not in {"layouts", "components", "partials", "vendor"}:
            return parts[2]
        return "Views"
    if rel.startswith("routes/"):
        return "Routes"
    if rel.startswith("database/"):
        return "Database"
    if rel.startswith("tests/"):
        return "Tests"
    if rel.startswith("wp-content/plugins/"):
        return parts[2] if len(parts) > 2 else "Plugins"
    if rel.startswith("wp-content/themes/"):
        return parts[2] if len(parts) > 2 else "Themes"
    if rel.startswith("wp-content/mu-plugins/"):
        return "Must-Use Plugins"
    return parts[0] if parts else "Root"

def responsibility(rel: str) -> str:
    low = rel.lower()
    for token, code, _label in RESPONSIBILITIES:
        if token in low:
            return code
    return DEFAULT_RESPONSIBILITY[0]

def parse_hook(verb: str, body: str) -> dict[str, str]:
    strings = ROUTE_STRING.findall(body)
    # register_rest_route(namespace, route, ...) — the endpoint is the first
    # two strings combined; every other hook names itself in the first string.
    if verb == "register_rest_route" and len(strings) > 1:
        strings = [strings[0].rstrip("/") + "/" + strings[1].lstrip("/")] + strings[2:]
    uri = strings[0] if strings else ""
    handler = ""
    m = ROUTE_CLASS_HANDLER.search(body)
    if m:
        cls = m.group(1).rsplit("\\", 1)[-1]
        handler = f"{cls}@{m.group(2)}" if m.group(2) else cls
    else:
        # Skip the literal 'callback' array key so ['callback' => 'fn'] maps to fn.
        candidates = [s for s in strings[1:] if s != "callback"]
        if candidates:
            handler = candidates[0].rsplit("\\", 1)[-1]
    return {"method": verb, "uri": uri, "handler": handler or "closure"}

def parse_route(verb: str, body: str) -> dict[str, str]:
    strings = ROUTE_STRING.findall(body)
    uri = next((s for s in strings if s.lower() not in HTTP_VERBS and "@" not in s), strings[0] if strings else "")
    handler = ""
    m = ROUTE_CLASS_HANDLER.search(body)
    if m:
        cls = m.group(1).rsplit("\\", 1)[-1]
        handler = f"{cls}@{m.group(2)}" if m.group(2) else cls
    else:
        m = ROUTE_AT_HANDLER.search(body)
        if m:
            handler = m.group(1).rsplit("\\", 1)[-1]
    return {"method": verb.upper(), "uri": uri, "handler": handler or "closure"}

def parse(path: Path, rel: str) -> dict[str, Any]:
    text = path.read_text(encoding="utf-8", errors="replace")
    symbols: list[dict[str, str]] = []
    imports: list[str] = []
    routes: list[dict[str, str]] = []
    relations: list[dict[str, str]] = []
    namespace = None

    if path.suffix.lower() == ".php" or rel.startswith("routes/"):
        m = PHP_NAMESPACE.search(text)
        namespace = m.group(1).strip() if m else None
        for m in PHP_DECL.finditer(text):
            if m.group("func"):
                symbols.append({"kind": "function", "name": m.group("func")})
            else:
                symbols.append({"kind": m.group("kind"), "name": m.group("type")})
        imports = [m.group(1).strip() for m in PHP_USE.finditer(text)]
        for m in ROUTE.finditer(text):
            routes.append(parse_route(m.group("verb"), m.group("body")))
        for m in RELATION.finditer(text):
            relations.append({
                "kind": "eloquent",
                "type": m.group("kind"),
                "target": " ".join(m.group("target").split())[:200],
            })
        # WordPress hooks/filters/shortcodes/REST routes are that ecosystem's
        # entry points, the same role Route:: calls play for Laravel — surface
        # them through the same `routes` field so they land in ROUTES.md for free.
        for m in HOOK.finditer(text):
            routes.append(parse_hook(m.group("verb"), m.group("body")))
    elif path.suffix.lower() in {".js", ".jsx", ".ts", ".tsx", ".vue"}:
        for m in JS_DECL.finditer(text):
            name = m.group("func") or m.group("const") or m.group("class")
            kind = "function" if m.group("func") else ("class" if m.group("class") else "export")
            symbols.append({"kind": kind, "name": name})
        imports = [m.group(1) for m in JS_IMPORT.finditer(text)]

    tables = sorted(set(TABLE.findall(text)))
    return {
        "path": rel,
        "language": path.suffix.lower().lstrip(".") or path.name,
        "namespace": namespace,
        "responsibility": responsibility(rel),
        "domain": domain_of(rel),
        "symbols": symbols,
        "imports": imports[:100],
        "routes": routes,
        "relations": relations,
        "tables": tables,
    }

def internal_import_filter(records: dict[str, Any]):
    # Keep only project-internal imports in RELATIONS.md: PHP imports whose
    # root namespace is declared somewhere in this project, and relative or
    # aliased JS imports. Framework/vendor imports stay out of the generated
    # markdown (they remain available in SYMBOLS.jsonl).
    php_roots = set()
    for rec in records.values():
        ns = rec.get("namespace")
        if ns:
            php_roots.add(ns.split("\\")[0])

    def is_internal(imp: str) -> bool:
        if imp.startswith(("./", "../", "@/", "~/")):
            return True
        if "\\" in imp:
            return imp.split("\\")[0] in php_roots
        return False

    return is_internal

def markdown_table(headers: list[str], rows: list[list[str]]) -> str:
    out = ["| " + " | ".join(headers) + " |", "|" + "|".join(["---"] * len(headers)) + "|"]
    for row in rows:
        safe = [str(v).replace("|", "\\|").replace("\n", " ") for v in row]
        out.append("| " + " | ".join(safe) + " |")
    return "\n".join(out)

def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("project", nargs="?", default=".")
    ap.add_argument("--full", action="store_true")
    args = ap.parse_args()

    root = Path(args.project).resolve()
    out = root / ".ai/project-index"
    domains_dir = out / "DOMAINS"
    out.mkdir(parents=True, exist_ok=True)
    domains_dir.mkdir(parents=True, exist_ok=True)
    manifest_path = out / "manifest.json"
    symbols_path = out / "SYMBOLS.jsonl"
    legacy_symbols_path = out / "SYMBOLS.json"

    old_manifest = {}
    old_symbols: dict[str, Any] = {}
    if not args.full and manifest_path.exists():
        try:
            old_manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        except Exception:
            old_manifest = {}
    # A version bump invalidates cached records: their shape (route fields,
    # responsibility codes, ...) may have changed with the format.
    if old_manifest.get("version") != VERSION:
        old_manifest = {}
    if not args.full and old_manifest and symbols_path.exists():
        try:
            for line in symbols_path.read_text(encoding="utf-8").splitlines():
                rec = json.loads(line)
                if "path" in rec:
                    old_symbols[rec["path"]] = rec
        except Exception:
            old_symbols = {}

    files = discover(root)
    current_paths = {p.relative_to(root).as_posix(): p for p in files}
    old_hashes = old_manifest.get("files", {})
    records: dict[str, Any] = {}
    manifest_files: dict[str, str] = {}

    for rel, path in current_paths.items():
        h = digest(path)
        manifest_files[rel] = h
        if not args.full and old_hashes.get(rel) == h and rel in old_symbols:
            records[rel] = old_symbols[rel]
        else:
            records[rel] = parse(path, rel)

    domains: dict[str, list[dict[str, Any]]] = defaultdict(list)
    all_routes = []
    all_relations = []
    for record in records.values():
        domains[record["domain"]].append(record)
        for route in record["routes"]:
            all_routes.append({"file": record["path"], **route})
        for relation in record["relations"]:
            all_relations.append({"file": record["path"], **relation})

    framework = []
    if (root / "artisan").exists():
        framework.append("Laravel")
    if (root / "resources/js").exists():
        framework.append("JavaScript/TypeScript frontend")
    if (root / "wp-content").exists() or (root / "wp-load.php").exists() or (root / "wp-config.php").exists():
        framework.append("WordPress")
    if (root / "wp-content/plugins/woocommerce").exists():
        framework.append("WooCommerce")
    if (root / "composer.json").exists():
        framework.append("Composer")
    if (root / "package.json").exists():
        framework.append("Node.js")

    # PROJECT_MAP.md is the tier-1 read: stack, domains, entry points, legend,
    # and a few key files per domain — most tasks should need only this file
    # plus one DOMAINS/*.md.
    project_map = [
        "# Project Map",
        "",
        f"- Index version: `{VERSION}`",
        f"- Detected stack: `{', '.join(framework) or 'Generic'}`",
        f"- Indexed files: `{len(records)}`",
        "",
        "## Domains",
        "",
    ]
    for name in sorted(domains):
        project_map.append(f"- [{name}](DOMAINS/{re.sub(r'[^A-Za-z0-9._-]+', '-', name)}.md): {len(domains[name])} files")
    project_map += ["", "## Primary entry points", ""]
    for candidate in ["routes/web.php", "routes/api.php", "routes/console.php", "app/Http/Kernel.php", "bootstrap/app.php", "resources/js/app.tsx", "resources/js/app.jsx"]:
        if candidate in records:
            project_map.append(f"- `{candidate}` — {LEGEND[records[candidate]['responsibility']]}")
    project_map += ["", "## Key files per domain", ""]
    priority = {code: i for i, code in enumerate(KEY_FILE_PRIORITY)}
    for name in sorted(domains):
        ranked = sorted(
            (r for r in domains[name] if r["responsibility"] in priority),
            key=lambda r: (priority[r["responsibility"]], r["path"]),
        )[:8]
        if not ranked:
            continue
        project_map.append(f"### {name}")
        for rec in ranked:
            project_map.append(f"- `{rec['path']}` ({rec['responsibility']})")
        project_map.append("")
    project_map += [
        "## Responsibility codes",
        "",
        ", ".join(f"`{code}`={label}" for code, label in sorted(LEGEND.items())),
    ]
    (out / "PROJECT_MAP.md").write_text("\n".join(project_map) + "\n", encoding="utf-8")

    route_rows = [[r["method"], r["uri"], r["handler"], r["file"]] for r in all_routes]
    routes_md = "# Routes\n\n"
    routes_md += markdown_table(["Method", "URI", "Handler", "File"], route_rows) if route_rows else "_No routes detected._"
    (out / "ROUTES.md").write_text(routes_md + "\n", encoding="utf-8")

    # FILES.md is a compact path -> domain map; per-file symbols live in
    # DOMAINS/*.md and SYMBOLS.jsonl instead of being duplicated here.
    files_md = ["# Files", "", "Responsibility codes: see PROJECT_MAP.md.", ""]
    for name in sorted(domains):
        files_md.append(f"## {name} ({len(domains[name])})")
        for rec in sorted(domains[name], key=lambda r: r["path"]):
            files_md.append(f"- {rec['path']} ({rec['responsibility']})")
        files_md.append("")
    (out / "FILES.md").write_text("\n".join(files_md).rstrip() + "\n", encoding="utf-8")

    is_internal = internal_import_filter(records)
    relation_rows = []
    for rel in sorted(records):
        rec = records[rel]
        internal_imports = [imp for imp in rec["imports"] if is_internal(imp)]
        for imp in internal_imports[:20]:
            relation_rows.append([rel, "import", imp])
        for relation in rec["relations"]:
            relation_rows.append([rel, relation["type"], relation["target"]])
        for table in rec["tables"]:
            relation_rows.append([rel, "table", table])
    relations_md = "# Relationships\n\nProject-internal imports only; full import lists live in SYMBOLS.jsonl.\n\n"
    relations_md += markdown_table(["Source", "Relation", "Target"], relation_rows) if relation_rows else "_No relationships detected._"
    (out / "RELATIONS.md").write_text(relations_md + "\n", encoding="utf-8")

    existing_domain_files = set(domains_dir.glob("*.md"))
    generated_domain_files = set()
    for name, items in sorted(domains.items()):
        safe = re.sub(r"[^A-Za-z0-9._-]+", "-", name)
        dest = domains_dir / f"{safe}.md"
        generated_domain_files.add(dest)
        rows = []
        for rec in sorted(items, key=lambda x: x["path"]):
            rows.append([
                rec["path"],
                rec["responsibility"],
                ", ".join(s["name"] for s in rec["symbols"][:10]),
            ])
        dest.write_text(
            f"# Domain: {name}\n\nResponsibility codes: see PROJECT_MAP.md.\n\n"
            + markdown_table(["File", "Resp", "Symbols"], rows) + "\n",
            encoding="utf-8"
        )
    for stale in existing_domain_files - generated_domain_files:
        stale.unlink()

    # One compact JSON record per line so exact lookups are a single-line
    # grep instead of a whole-file read.
    symbol_lines = [json.dumps({"version": VERSION, "files": len(records)}, ensure_ascii=False, separators=(",", ":"))]
    for rel in sorted(records):
        symbol_lines.append(json.dumps(records[rel], ensure_ascii=False, separators=(",", ":")))
    symbols_path.write_text("\n".join(symbol_lines) + "\n", encoding="utf-8")
    if legacy_symbols_path.exists():
        legacy_symbols_path.unlink()

    manifest = {
        "version": VERSION,
        "files": manifest_files,
    }
    manifest_path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")

    readme = out / "README.md"
    if not readme.exists():
        readme.write_text(
            "# Project Intelligence Index\n\nGenerated by `ai-dev-project-index`.\n",
            encoding="utf-8"
        )

    print(f"Project index: {out}")
    print(f"Indexed: {len(records)} files")

if __name__ == "__main__":
    main()
