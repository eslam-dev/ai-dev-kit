PHP_DECL = re.compile(
    r"(?m)^\s*(?:final\s+|abstract\s+|readonly\s+)?"
    r"(?:(?P<kind>class|interface|trait|enum)\s+(?P<type>[A-Za-z_][A-Za-z0-9_]*)"
    r"|(?P<prefix>(?:(?:public|protected|private|static|final|abstract|readonly)\s+)*)"
    r"function\s+(?P<func>[A-Za-z_][A-Za-z0-9_]*)\s*\()"
)
PHP_RETURN_TYPE = re.compile(r"\s*:\s*(?P<type>\??[\w\\|&\s]+?)\s*(?=[{;])")
PHP_DOC_SUMMARY = re.compile(r"(?m)^\s*\*\s*(?P<line>[^@\s][^\n]*)")
# Call edges, extracted from string/comment-masked source so literals never
# masquerade as calls.
CALL_THIS = re.compile(r"\$this->(?P<name>[A-Za-z_]\w*)\s*\(")
