CALL_NEW = re.compile(r"(?<![\w$])new\s+(?P<class>[A-Z][\w\\]*)\s*\(")
CALL_VAR = re.compile(r"\$(?!this\b)\w+->(?P<name>[A-Za-z_]\w*)\s*\(")
CALL_NOISE = {
