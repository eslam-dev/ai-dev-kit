WORD_SPLIT = re.compile(r"[-_.\s]+|(?<=[a-z0-9])(?=[A-Z])")


def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def is_ignored(rel: str) -> bool:
    rel = rel.replace("\\", "/")
    if any(rel == p.rstrip("/") or rel.startswith(p) for p in IGNORE_PREFIXES):
        return True
    return any(part in IGNORE_ANYWHERE for part in rel.split("/"))


def discover(root: Path) -> list[Path]:
    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = Path(dirpath).relative_to(root).as_posix()
        rel_dir = "" if rel_dir == "." else rel_dir
        # Prune ignored directories in place so os.walk never descends into
        # vendor/, node_modules/, .git/, etc. instead of filtering after a
        # full recursive walk.
        dirnames[:] = [
            d for d in dirnames
            if not is_ignored(f"{rel_dir}/{d}" if rel_dir else d)
        ]
        for name in filenames:
            rel = f"{rel_dir}/{name}" if rel_dir else name
            if is_ignored(rel):
                continue
            if Path(name).suffix.lower() in SOURCE_SUFFIXES or name in SPECIAL_FILES or rel.startswith("routes/"):
                files.append(Path(dirpath) / name)
    return sorted(files)


# ---------------------------------------------------------------------------
# Stack detection — single detector consumed by the indexer, ai-dev-init
# (via --print-stack), and ai-dev-project-rules (via manifest.json["stack"]).
# ---------------------------------------------------------------------------

def read_json(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def head_text(path: Path, limit: int = 8192) -> str:
    try:
        with path.open("r", encoding="utf-8", errors="replace") as f:
            return f.read(limit)
    except OSError:
        return ""


def laravel_major(constraint: str) -> int | None:
    """Major version from a composer constraint (`^11.9`, `>=10.0`, `12.*`).

    Used to gate strict-mode APIs: `Model::shouldBeStrict()` needs 9+,
    `DB::prohibitDestructiveCommands()` needs 11+. Returns None when the
    constraint is absent or unparseable — callers then suggest nothing.
    """
    m = re.search(r"(\d+)", str(constraint or ""))
    return int(m.group(1)) if m else None


def detect_stack(root: Path, source_file_count: int | None = None) -> dict[str, Any]:
    composer = read_json(root / "composer.json")
    require: dict[str, str] = {}
    for key in ("require", "require-dev"):
        section = composer.get(key)
        if isinstance(section, dict):
            require.update({str(k).lower(): str(v) for k, v in section.items()})

    def has_pkg(*names: str) -> bool:
        return any(n in require for n in names)

    has_composer = (root / "composer.json").exists()
    laravel = (root / "artisan").exists() or has_pkg("laravel/framework")
    livewire = has_pkg("livewire/livewire", "livewire/volt") or (root / "app/Livewire").is_dir() or (root / "app/Http/Livewire").is_dir()
    filament = has_pkg("filament/filament") or (root / "app/Filament").is_dir()
    inertia = has_pkg("inertiajs/inertia-laravel") or any(
        (root / f"resources/js/app.{ext}").exists() for ext in ("tsx", "jsx")
    )
    blade = (root / "resources/views").is_dir()
    symfony = has_pkg("symfony/framework-bundle") or (root / "config/bundles.php").exists()

    # WordPress subtypes: full site, plugin repo, theme repo.
    wordpress: dict[str, Any] | None = None
    if (root / "wp-config.php").exists() or (root / "wp-load.php").exists() or (root / "wp-content").is_dir():
        woo = (root / "wp-content/plugins/woocommerce").is_dir()
        wordpress = {"type": "site", "block_theme": False, "woocommerce": woo}
    else:
        for php in sorted(root.glob("*.php")):
            head = head_text(php)
            if re.search(r"^\s*\*?\s*Plugin Name\s*:", head, re.MULTILINE):
                woo = "woocommerce" in require or bool(re.search(r"WC requires at least", head))
                wordpress = {"type": "plugin", "block_theme": False, "woocommerce": woo}
                break
        if wordpress is None and (root / "style.css").exists():
            head = head_text(root / "style.css")
            if re.search(r"^\s*\*?\s*Theme Name\s*:", head, re.MULTILINE):
                block = (root / "theme.json").exists() or bool(list(root.glob("templates/*.html")))
                wordpress = {"type": "theme", "block_theme": block, "woocommerce": False}

    if has_pkg("pestphp/pest") or (root / "tests/Pest.php").exists():
        testing = "pest"
    elif has_pkg("phpunit/phpunit") or (root / "phpunit.xml").exists() or (root / "phpunit.xml.dist").exists():
        testing = "phpunit"
    else:
        testing = "none"

    if has_pkg("larastan/larastan", "nunomaduro/larastan"):
        static_analysis = "larastan"
    elif has_pkg("phpstan/phpstan") or any((root / n).exists() for n in ("phpstan.neon", "phpstan.neon.dist", "phpstan.dist.neon")):
        static_analysis = "phpstan"
    elif has_pkg("vimeo/psalm") or (root / "psalm.xml").exists():
        static_analysis = "psalm"
    else:
        static_analysis = "none"

    if has_pkg("laravel/pint") or (root / "pint.json").exists():
        formatter = "pint"
    elif has_pkg("friendsofphp/php-cs-fixer") or (root / ".php-cs-fixer.dist.php").exists() or (root / ".php-cs-fixer.php").exists():
        formatter = "php-cs-fixer"
    elif has_pkg("squizlabs/php_codesniffer"):
        formatter = "phpcs"
    else:
        formatter = "none"

    scripts = {}
    raw_scripts = composer.get("scripts")
    if isinstance(raw_scripts, dict):
        for name, cmd in raw_scripts.items():
            if isinstance(cmd, list):
                cmd = " && ".join(str(c) for c in cmd)
            scripts[str(name)] = str(cmd)[:120]

    psr4: dict[str, str] = {}
    autoload = composer.get("autoload")
    if isinstance(autoload, dict) and isinstance(autoload.get("psr-4"), dict):
        for prefix, path in autoload["psr-4"].items():
            if isinstance(path, list):
                path = path[0] if path else ""
            psr4[str(prefix)] = str(path).strip("/")

    new_project = (
        not has_composer and not laravel and wordpress is None
        and (source_file_count is not None and source_file_count < 3)
    )

    return {
        "laravel": laravel,
        "livewire": livewire,
        "filament": filament,
        "horizon": has_pkg("laravel/horizon"),
        "inertia": inertia,
        "blade": blade,
        "sanctum": has_pkg("laravel/sanctum"),
        "passport": has_pkg("laravel/passport"),
        "tenancy": has_pkg("stancl/tenancy", "spatie/laravel-multitenancy"),
        "symfony": symfony,
        "composer": has_composer,
        "node": (root / "package.json").exists(),
        "wordpress": wordpress,
        "php_version": str(require.get("php", "")),
        "laravel_version": laravel_major(require.get("laravel/framework", "")),
        "testing": testing,
        "static_analysis": static_analysis,
        "formatter": formatter,
        "composer_scripts": scripts,
        "psr4": psr4,
        "new_project": new_project,
    }


def stack_labels(stack: dict[str, Any]) -> list[str]:
    labels = []
    if stack["laravel"]:
        labels.append("Laravel")
    if stack["livewire"]:
        labels.append("Livewire")
    if stack["filament"]:
        labels.append("Filament")
    if stack["inertia"]:
        labels.append("Inertia")
    if stack["blade"]:
        labels.append("Blade")
    if stack["symfony"]:
        labels.append("Symfony")
    wp = stack.get("wordpress")
    if wp:
        labels.append(f"WordPress ({wp['type']})")
        if wp.get("woocommerce"):
            labels.append("WooCommerce")
    if stack["composer"] and not labels:
        labels.append("PHP (Composer)")
    if stack["node"]:
        labels.append("Node.js")
    return labels or ["Generic"]


# ---------------------------------------------------------------------------
# Responsibility + domain classification
# ---------------------------------------------------------------------------

def word_units(rel: str) -> set[str]:
    units: set[str] = set()
    parts = Path(rel).parts
    for i, segment in enumerate(parts):
        # The framework asset root `resources/` must never satisfy the word
        # token "resource" (API resources live under app/**/Resources).
        if i == 0 and segment.lower() == "resources":
            continue
        stem = segment
        if "." in segment and segment == parts[-1]:
            stem = segment.split(".")[0]
        for unit in WORD_SPLIT.split(stem):
            if unit:
                units.add(unit.lower())
    return units


def responsibility(rel: str, is_wp: bool = False) -> str:
    low = rel.lower()
    if is_wp and rel.endswith((".php", ".html")) and WP_TEMPLATE_FILES.search(low):
        return WP_TEMPLATE_RESP[0]
    units = word_units(rel)
    for token, code, _label in RESPONSIBILITIES:
        if "/" in token:
            if low.startswith(token) or f"/{token}" in low:
                return code
        elif token in units or f"{token}s" in units:
            return code
    return DEFAULT_RESPONSIBILITY[0]


def domain_of(rel: str, psr4_dirs: list[str]) -> str:
    parts = Path(rel).parts
    if rel.startswith("app/"):
        if len(parts) >= 4 and parts[1] in {"Domain", "Domains", "Modules"}:
            return parts[2]
        return parts[1] if len(parts) > 1 else "Application"
    if rel.startswith("resources/js/"):
        if len(parts) >= 4 and parts[2].lower() in {"pages", "features", "modules"}:
            return parts[3]
        return "Frontend"
    if rel.startswith("resources/views/"):
        if len(parts) >= 3 and parts[2].lower() not in {"layouts", "components", "partials", "vendor"}:
            return parts[2]
        return "Views"
    if rel.startswith("routes/"):
        return "Routes"
    if rel.startswith("database/"):
        return "Database"
    if rel.startswith("tests/"):
        return "Tests"
    if rel.startswith("config/"):
        return "Config"
    if rel.startswith("wp-content/plugins/"):
        return parts[2] if len(parts) > 2 else "Plugins"
    if rel.startswith("wp-content/themes/"):
        return parts[2] if len(parts) > 2 else "Themes"
    if rel.startswith("wp-content/mu-plugins/"):
        return "Must-Use Plugins"
    # PSR-4 autoload roots (e.g. src/): the first subdirectory is the domain.
    for base in psr4_dirs:
        if base and rel.startswith(base + "/"):
            rest = parts[len(Path(base).parts):]
            if len(rest) >= 2:
                return rest[0]
            return Path(base).parts[0].capitalize()
    if len(parts) <= 1:
        return "Root"
    return parts[0]


# ---------------------------------------------------------------------------
# Route / hook parsing
# ---------------------------------------------------------------------------

def statement_body(text: str, start: int, cap: int = 400, scan: str | None = None) -> str:
    """From an opening position, consume until the first `;` at paren depth 0.

    `scan` is the string/comment-masked copy used for delimiter tracking, so a
    `;` or `)` inside a literal never truncates the statement; the returned
    slice always comes from the real source.
    """
    probe = scan if scan is not None else text
    depth = 0
    end = min(len(probe), start + cap)
    for i in range(start, end):
        c = probe[i]
        if c == "(":
            depth += 1
        elif c == ")":
            depth -= 1
        elif c == ";" and depth <= 0:
            return text[start:i]
    return text[start:end]


def brace_spans(text: str, masked: str | None = None) -> list[tuple[int, int, dict[str, str]]]:
    """Spans of Route::...->group(function() { ... }) blocks with their attrs."""
    probe = masked if masked is not None else text
    spans = []
    for m in ROUTE_GROUP.finditer(text):
        attrs: dict[str, str] = {}
        for am in GROUP_ATTR.finditer(m.group("chain")):
            raw = am.group("val")
            sm = ROUTE_STRING.search(raw)
            cm = re.search(r"([A-Za-z_][\w\\]*)::class", raw)
            if am.group("key") == "controller" and cm:
                attrs["controller"] = cm.group(1).rsplit("\\", 1)[-1]
            elif sm:
                attrs[am.group("key")] = sm.group(1)
        brace = probe.find("{", m.end())
        if brace == -1:
            continue
        depth = 0
        close = -1
        for i in range(brace, len(probe)):
            if probe[i] == "{":
                depth += 1
            elif probe[i] == "}":
                depth -= 1
                if depth == 0:
                    close = i
                    break
        if close != -1:
            spans.append((brace, close, attrs))
    return spans


def parse_route(verb: str, body: str, groups: list[dict[str, str]]) -> dict[str, str]:
    strings = ROUTE_STRING.findall(body)
    uri = next((s for s in strings if s.lower() not in HTTP_VERBS and "@" not in s), strings[0] if strings else "")
    handler = ""
    m = ROUTE_CLASS_HANDLER.search(body)
    if m:
        cls = m.group(1).rsplit("\\", 1)[-1]
        handler = f"{cls}@{m.group(2)}" if m.group(2) else cls
    else:
        m = ROUTE_AT_HANDLER.search(body)
        if m:
            handler = m.group(1).rsplit("\\", 1)[-1]
    prefix_parts = [g["prefix"].strip("/") for g in groups if g.get("prefix")]
    if prefix_parts:
        uri = "/".join(prefix_parts + [uri.lstrip("/")])
    if not handler:
        # Route::get('/x', 'method') inside Route::controller(X::class)->group()
        controller = next((g["controller"] for g in reversed(groups) if g.get("controller")), "")
        method_str = next((s for s in strings[1:] if s != uri), "")
        if controller and method_str and "/" not in method_str:
            handler = f"{controller}@{method_str}"
    name_m = ROUTE_NAME.search(body)
    name = name_m.group(1) if name_m else ""
    name_prefix = "".join(g["name"] for g in groups if g.get("name"))
    if name:
        name = name_prefix + name
    route = {"method": verb.upper(), "uri": uri, "handler": handler or "closure"}
    if name:
        route["name"] = name
    return route


def parse_hook(verb: str, body: str) -> dict[str, str]:
    strings = ROUTE_STRING.findall(body)

    if verb == "register_rest_route":
        uri = ""
        if len(strings) > 1:
            uri = strings[0].rstrip("/") + "/" + strings[1].lstrip("/")
        elif strings:
            uri = strings[0]
        # Resolve the callback positionally: find the 'callback' array key and
        # take the value after its =>. "First non-key string" wrongly picked up
        # 'methods' values like GET/POST.
        handler = ""
        cb = re.search(r"['\"]callback['\"]\s*=>\s*(.{0,160})", body)
        if cb:
            val = cb.group(1)
            cm = ROUTE_CLASS_HANDLER.search(val)
            sm = ROUTE_STRING.search(val)
            if cm:
                cls = cm.group(1).rsplit("\\", 1)[-1]
                handler = f"{cls}@{cm.group(2)}" if cm.group(2) else cls
            elif sm:
                handler = sm.group(1).rsplit("\\", 1)[-1]
        if "permission_callback" not in body:
            handler = (handler or "closure") + " (NO permission_callback)"
        return {"method": "REST", "uri": uri, "handler": handler or "closure"}

    if verb == "register_post_type":
        return {"method": "CPT", "uri": strings[0] if strings else "", "handler": ""}
    if verb == "register_taxonomy":
        return {"method": "TAXONOMY", "uri": strings[0] if strings else "", "handler": strings[1] if len(strings) > 1 else ""}
    if verb == "register_block_type":
        return {"method": "BLOCK", "uri": strings[0] if strings else "", "handler": ""}
    if verb in ("register_activation_hook", "register_deactivation_hook", "register_uninstall_hook"):
        kind = verb.split("_")[1].upper()
        handler = strings[1].rsplit("\\", 1)[-1] if len(strings) > 1 else ""
        m = ROUTE_CLASS_HANDLER.search(body)
        if m:
            cls = m.group(1).rsplit("\\", 1)[-1]
            handler = f"{cls}@{m.group(2)}" if m.group(2) else cls
        return {"method": kind, "uri": strings[0].rsplit("/", 1)[-1] if strings else "", "handler": handler or "closure"}

    uri = strings[0] if strings else ""
    handler = ""
    m = ROUTE_CLASS_HANDLER.search(body)
    if m:
        cls = m.group(1).rsplit("\\", 1)[-1]
        handler = f"{cls}@{m.group(2)}" if m.group(2) else cls
    else:
        candidates = [s for s in strings[1:] if s != "callback"]
        if candidates:
            handler = candidates[0].rsplit("\\", 1)[-1]
    return {"method": verb, "uri": uri, "handler": handler or "closure"}


def parse_schema(text: str) -> list[dict[str, Any]]:
    """Column-level ops per Schema::create/table block, for SCHEMA.md."""
    blocks = []
    for m in SCHEMA_BLOCK.finditer(text):
        brace = text.find("{", m.end())
        if brace == -1:
            continue
        depth = 0
        close = len(text)
        for i in range(brace, len(text)):
            if text[i] == "{":
                depth += 1
            elif text[i] == "}":
                depth -= 1
                if depth == 0:
                    close = i
                    break
        body = text[brace:close]
        columns, indexes, drops = [], [], []
        for cm in SCHEMA_COLUMN.finditer(body):
            method, name = cm.group("method"), cm.group("name") or ""
            if method in SCHEMA_DROPS:
                drops.append(name or method)
            elif method in SCHEMA_INDEXES:
                indexes.append(f"{method}({name})" if name else method)
            elif method in SCHEMA_COLUMN_TYPES:
                columns.append({"name": name or method, "type": method})
        blocks.append({
            "table": m.group("table"), "op": m.group("op"),
            "columns": columns, "indexes": indexes, "drops": drops,
        })
    return blocks


# ---------------------------------------------------------------------------
# Declaration extraction — signatures, body ranges, docblock summaries, calls.
# This is what lets an agent call or edit a symbol without opening the file.
# ---------------------------------------------------------------------------

def mask_php(text: str) -> str:
    """Blank out string literals and comments, preserving length and offsets.

    Structural scanning (brace matching, call edges) runs on the masked copy so
    a brace or `foo(` inside a string or comment can never shift a body range.
    """
    out = list(text)
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c in "'\"":
            quote = c
            j = i + 1
            while j < n:
                if text[j] == "\\":
                    j += 2
                    continue
                if text[j] == quote:
                    break
                j += 1
            for k in range(i + 1, min(j, n)):
                if out[k] != "\n":
                    out[k] = " "
            i = j + 1
            continue
        if text.startswith("//", i) or c == "#":
            j = text.find("\n", i)
            j = n if j == -1 else j
            for k in range(i, j):
                out[k] = " "
            i = j
            continue
        if text.startswith("/*", i):
            j = text.find("*/", i + 2)
            j = n if j == -1 else j + 2
            for k in range(i, j):
                if out[k] != "\n":
                    out[k] = " "
            i = j
            continue
        if text.startswith("<<<", i):
            m = re.match(r"<<<\s*['\"]?(\w+)['\"]?\r?\n", text[i:])
            if m:
                label = m.group(1)
                end = re.search(rf"(?m)^\s*{label}\b", text[i + m.end():])
                j = i + m.end() + (end.start() if end else 0)
                for k in range(i, min(j, n)):
                    if out[k] != "\n":
                        out[k] = " "
                i = max(j, i + m.end())
                continue
        i += 1
    return "".join(out)


def balanced(masked: str, start: int, opener: str = "(", closer: str = ")", cap: int = 4000) -> tuple[str, int]:
    """From the index just after an opening delimiter, return (inner, index_after_close)."""
    depth = 1
    end = min(len(masked), start + cap)
    i = start
    while i < end:
        c = masked[i]
        if c == opener:
            depth += 1
        elif c == closer:
            depth -= 1
            if depth == 0:
                return masked[start:i], i + 1
        i += 1
    return masked[start:end], end


def php_signature(text: str, masked: str, after_paren: int) -> tuple[str, int]:
    """Normalized `(params): ret` plus the offset where the body/`;` begins."""
    _, close = balanced(masked, after_paren)
    params = " ".join(text[after_paren:close - 1].split())
    sig = f"({params})"
    m = PHP_RETURN_TYPE.match(masked, close)
    if m:
        sig += ": " + " ".join(text[m.start("type"):m.end("type")].split())
        close = m.end()
    return sig[:240], close


def body_range(masked: str, body_start: int) -> int | None:
    """Offset of the declaration's closing brace (None for abstract/interface)."""
    i = body_start
    n = len(masked)
    while i < n and masked[i] in " \t\r\n":
        i += 1
    if i >= n or masked[i] == ";":
        return None
    if masked[i] != "{":
        return None
    depth = 0
    for j in range(i, n):
        if masked[j] == "{":
            depth += 1
        elif masked[j] == "}":
            depth -= 1
            if depth == 0:
                return j
    return None


def docblock_summary(text: str, decl_start: int) -> str:
    """First prose line of the PHPDoc immediately above a declaration."""
    head = text.rfind("*/", max(0, decl_start - 3000), decl_start)
    if head == -1:
        return ""
    between = text[head + 2:decl_start]
    # Only attributes/whitespace may sit between the docblock and the declaration.
    if between.strip() and not all(
        line.strip().startswith("#[") or not line.strip()
        for line in between.splitlines()
    ):
        return ""
    open_at = text.rfind("/**", 0, head)
    if open_at == -1:
        return ""
    m = PHP_DOC_SUMMARY.search(text[open_at:head])
    if not m:
        return ""
    return " ".join(m.group("line").split())[:140]


def call_edges(masked: str, start: int, end: int, self_class: str | None) -> list[str]:
    """Outgoing call targets inside a body: Class::method, Self::method, method."""
    body = masked[start:end]
    edges: list[str] = []
    for m in CALL_THIS.finditer(body):
        if m.group("name") not in CALL_NOISE:
            edges.append(f"{self_class}::{m.group('name')}" if self_class else m.group("name"))
    for m in CALL_STATIC.finditer(body):
        if m.group("name") not in CALL_NOISE:
            cls = m.group("class")
            edges.append(f"{'self' if cls in {'self', 'static'} and self_class is None else cls}::{m.group('name')}")
    for m in CALL_NEW.finditer(body):
        edges.append(f"{m.group('class').rsplit(chr(92), 1)[-1]}::__construct")
    for m in CALL_VAR.finditer(body):
        if m.group("name") not in CALL_NOISE:
            edges.append(m.group("name"))
    seen, unique = set(), []
    for edge in edges:
        if edge not in seen:
            seen.add(edge)
            unique.append(edge)
    return unique[:40]


# ---------------------------------------------------------------------------
# Per-file parsing
# ---------------------------------------------------------------------------

def parse(path: Path, rel: str, is_wp: bool, psr4_dirs: list[str]) -> dict[str, Any]:
    try:
        size = path.stat().st_size
    except OSError:
        size = 0
    if size > MAX_PARSE_BYTES:
        return {
            "path": rel, "language": path.suffix.lower().lstrip(".") or path.name,
            "namespace": None, "responsibility": responsibility(rel, is_wp),
            "domain": domain_of(rel, psr4_dirs), "symbols": [], "imports": [],
            "routes": [], "relations": [], "tables": [], "skipped": "too-large",
        }

    text = path.read_text(encoding="utf-8", errors="replace")
    symbols: list[dict[str, Any]] = []
    imports: list[str] = []
    routes: list[dict[str, str]] = []
    relations: list[dict[str, str]] = []
    extras: dict[str, Any] = {}
    namespace = None

    def line_of(pos: int) -> int:
        return text.count("\n", 0, pos) + 1

    if path.suffix.lower() == ".php" or rel.startswith("routes/"):
        masked = mask_php(text)
        m = PHP_NAMESPACE.search(text)
        namespace = m.group(1).strip() if m else None

        first_type_pos = None
        current_class = None
        pending_attrs: list[str] = []
        file_calls: list[str] = []
        # Interleave attribute lines and declarations by position.
        events = sorted(
            [(m.start(), "attr", m) for m in PHP_ATTR.finditer(text)]
            + [(m.start(), "decl", m) for m in PHP_DECL.finditer(text)]
            + [(m.start(), "prop", m) for m in PHP_PROP.finditer(text)],
            key=lambda e: e[0],
        )
        for pos, kind, m in events:
            if kind == "attr":
                pending_attrs.append(m.group("name"))
                continue
            if kind == "prop":
                sym = {"kind": "prop", "name": m.group("name"), "line": line_of(pos),
                       "visibility": m.group("vis")}
                if current_class:
                    sym["class"] = current_class
                if pending_attrs:
                    sym["attrs"] = pending_attrs
                pending_attrs = []
                symbols.append(sym)
                continue
            if m.group("func"):
                sym: dict[str, Any] = {"kind": "function", "name": m.group("func"), "line": line_of(pos)}
                if current_class:
                    sym["class"] = current_class
                vis = re.search(r"\b(public|protected|private)\b", m.group("prefix") or "")
                sym["visibility"] = vis.group(1) if vis else "public"
                # Declaration data an agent needs to call or edit this symbol
                # without opening the file: full signature, body range, summary.
                signature, body_start = php_signature(text, masked, m.end())
                sym["sig"] = signature
                close = body_range(masked, body_start)
                if close is not None:
                    sym["end"] = line_of(close)
                    file_calls.extend(call_edges(masked, body_start, close, current_class))
                else:
                    sym["abstract"] = True
                doc = docblock_summary(text, pos)
                if doc:
                    sym["doc"] = doc
                if pending_attrs:
                    sym["attrs"] = pending_attrs
            else:
                current_class = m.group("type")
                if first_type_pos is None:
                    first_type_pos = pos
                sym = {"kind": m.group("kind"), "name": m.group("type"), "line": line_of(pos)}
                brace = masked.find("{", m.end())
                if brace != -1:
                    close = body_range(masked, brace)
                    if close is not None:
                        sym["end"] = line_of(close)
                doc = docblock_summary(text, pos)
                if doc:
                    sym["doc"] = doc
                if pending_attrs:
                    sym["attrs"] = pending_attrs
            pending_attrs = []
            symbols.append(sym)

        # `use` before the first type declaration = import; inside a class = trait use.
        trait_uses = []
        for um in PHP_USE.finditer(text):
            target = um.group(1).strip()
            if first_type_pos is None or um.start() < first_type_pos:
                imports.append(target)
            else:
                trait_uses.append(target.split(",")[0].strip().rsplit("\\", 1)[-1])
        if trait_uses:
            extras["traits"] = trait_uses[:20]

        groups = brace_spans(text, masked)
        for rm in ROUTE_START.finditer(text):
            body = statement_body(text, rm.end(), scan=masked)
            active = [attrs for start, end, attrs in groups if start < rm.start() < end]
            routes.append(parse_route(rm.group("verb"), body, active))
        for hm in HOOK_START.finditer(text):
            body = statement_body(text, hm.end(), scan=masked)
            routes.append(parse_hook(hm.group("verb"), body))

        for m in RELATION.finditer(text):
            relations.append({
                "kind": "eloquent",
                "type": m.group("kind"),
                "target": " ".join(m.group("target").split())[:200],
            })
        for m in DOCTRINE_RELATION.finditer(text):
            if m.group("target"):
                relations.append({
                    "kind": "doctrine", "type": m.group("kind"),
                    "target": m.group("target").rsplit("\\", 1)[-1],
                })
        for m in LISTENER_HANDLE.finditer(text):
            relations.append({"kind": "listens", "type": "handle", "target": m.group(1).rsplit("\\", 1)[-1]})
        for m in EVENT_DISPATCH.finditer(text):
            target = (m.group(1) or m.group(2) or "").rsplit("\\", 1)[-1]
            if target:
                relations.append({"kind": "event", "type": "dispatch", "target": target})
        for m in POLICY_PAIR.finditer(text):
            relations.append({"kind": "policy", "type": "maps", "target": f"{m.group(1).rsplit(chr(92), 1)[-1]} => {m.group(2).rsplit(chr(92), 1)[-1]}"})

        gates = [m.group(1) for m in GATE_DEFINE.finditer(text)]
        if gates:
            extras["gates"] = gates[:20]

        schedules = []
        for m in SCHEDULE.finditer(text):
            target = m.group("target").strip().strip("'\"")
            target = target.rsplit("\\", 1)[-1].replace("::class", "")
            freq = m.group("freq")
            arg = m.group(4).strip().strip("'\"")
            schedules.append({"kind": m.group("kind"), "target": target[:80], "frequency": f"{freq}({arg})" if arg else freq})
        if schedules:
            extras["schedule"] = schedules

        base_class = ""
        bm = PHP_EXTENDS.search(text)
        if bm:
            base_class = bm.group(1).rsplit("\\", 1)[-1]
            extras["extends"] = base_class

        if "Livewire" in text and base_class == "Component" and current_class:
            routes.append({"method": "LIVEWIRE", "uri": current_class, "handler": current_class})
        if rel.startswith("app/Filament") and current_class and current_class.endswith("Resource"):
            model_m = re.search(r"\$model\s*=\s*([A-Za-z_][\w\\]*)::class", text)
            routes.append({
                "method": "FILAMENT", "uri": current_class,
                "handler": model_m.group(1).rsplit("\\", 1)[-1] if model_m else "",
            })

        if "implements" in text or "ShouldQueue" in text:
            queue_meta = {}
            if re.search(r"implements[^{]*ShouldQueue", text):
                queue_meta["queued"] = True
            if re.search(r"implements[^{]*ShouldBeUnique", text) or "ShouldBeUnique" in text and "implements" in text:
                if re.search(r"ShouldBeUnique", text):
                    queue_meta["unique"] = True
            qm = ON_QUEUE.search(text)
            if qm:
                queue_meta["queue"] = qm.group(1) or qm.group(2)
            if queue_meta:
                extras["queue"] = queue_meta

        env_keys = sorted(set(ENV_KEY.findall(text)))[:20]
        config_keys = sorted(set(CONFIG_KEY.findall(text)))[:20]
        if env_keys:
            extras["env_keys"] = env_keys
        if config_keys:
            extras["config_keys"] = config_keys

        if rel.startswith("database/migrations/"):
            schema = parse_schema(text)
            if schema:
                extras["schema"] = schema

        if file_calls:
            seen, unique = set(), []
            for edge in file_calls:
                if edge not in seen:
                    seen.add(edge)
                    unique.append(edge)
            extras["calls"] = unique[:80]

    elif path.suffix.lower() in {".js", ".jsx", ".ts", ".tsx", ".vue"}:
        for m in JS_DECL.finditer(text):
            name = m.group("func") or m.group("const") or m.group("class")
            kind = "function" if m.group("func") else ("class" if m.group("class") else "export")
            symbols.append({"kind": kind, "name": name, "line": line_of(m.start())})
        imports = [m.group(1) for m in JS_IMPORT.finditer(text)]

    tables = sorted(set(TABLE.findall(text))) if path.suffix.lower() in {".php", ".sql"} else []
    record = {
        "path": rel,
        "language": path.suffix.lower().lstrip(".") or path.name,
        "namespace": namespace,
        "responsibility": responsibility(rel, is_wp),
        "domain": domain_of(rel, psr4_dirs),
        "symbols": symbols,
        "imports": imports[:100],
        "routes": routes,
        "relations": relations,
        "tables": tables,
    }
    record.update(extras)
    return record


def internal_import_filter(records: dict[str, Any]):
    # Keep only project-internal imports in RELATIONS.md: PHP imports whose
    # root namespace is declared somewhere in this project, and relative or
    # aliased JS imports. Framework/vendor imports stay out of the generated
    # markdown (they remain available in SYMBOLS.jsonl).
    php_roots = set()
    for rec in records.values():
        ns = rec.get("namespace")
        if ns:
            php_roots.add(ns.split("\\")[0])

    def is_internal(imp: str) -> bool:
        if imp.startswith(("./", "../", "@/", "~/")):
            return True
        if "\\" in imp:
            return imp.split("\\")[0] in php_roots
        return False

    return is_internal


def write_if_changed(path: Path, content: str) -> None:
    """Write only when content differs — keeps re-runs free of mtime churn."""
    if path.exists():
        try:
            if path.read_text(encoding="utf-8") == content:
                return
        except OSError:
            pass
    path.write_text(content, encoding="utf-8")


def markdown_table(headers: list[str], rows: list[list[str]]) -> str:
    out = ["| " + " | ".join(headers) + " |", "|" + "|".join(["---"] * len(headers)) + "|"]
    for row in rows:
        safe = [str(v).replace("|", "\\|").replace("\n", " ") for v in row]
        out.append("| " + " | ".join(safe) + " |")
    return "\n".join(out)


def runtime_routes(root: Path) -> list[dict[str, str]] | None:
    """Opt-in ground truth: `php artisan route:list --json` (never automatic)."""
    if not (root / "artisan").exists():
        return None
    try:
        proc = subprocess.run(
            ["php", "artisan", "route:list", "--json"],
            cwd=root, capture_output=True, text=True, timeout=15,
        )
        if proc.returncode != 0:
            return None
        data = json.loads(proc.stdout)
        rows = []
        for r in data:
            rows.append({
                "method": str(r.get("method", "")).split("|")[0],
                "uri": str(r.get("uri", "")),
                "name": str(r.get("name") or ""),
                "handler": str(r.get("action", "")).rsplit("\\", 1)[-1],
                "middleware": ",".join(r.get("middleware", [])) if isinstance(r.get("middleware"), list) else str(r.get("middleware") or ""),
            })
        return rows
    except Exception:
        return None


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("project", nargs="?", default=".")
    ap.add_argument("--full", action="store_true")
    ap.add_argument("--print-stack", action="store_true",
                    help="print detected stack JSON and exit (writes nothing)")
    ap.add_argument("--runtime", action="store_true",
                    help="additionally run `php artisan route:list --json` for ground-truth routes (opt-in; executes project code)")
    args = ap.parse_args()

    root = Path(args.project).resolve()

    if args.print_stack:
        files = discover(root)
        stack = detect_stack(root, source_file_count=len(files))
        print(json.dumps(stack, ensure_ascii=False, indent=1, sort_keys=True))
        return

    out = root / ".ai/project-index"
    domains_dir = out / "DOMAINS"
    out.mkdir(parents=True, exist_ok=True)
    domains_dir.mkdir(parents=True, exist_ok=True)
    manifest_path = out / "manifest.json"
    symbols_path = out / "SYMBOLS.jsonl"
    legacy_symbols_path = out / "SYMBOLS.json"

    old_manifest = {}
    old_symbols: dict[str, Any] = {}
    if not args.full and manifest_path.exists():
        try:
            old_manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        except Exception:
            old_manifest = {}
    # A version bump invalidates cached records: their shape (route fields,
    # responsibility codes, ...) may have changed with the format.
    if old_manifest.get("version") != VERSION:
        old_manifest = {}
    if not args.full and old_manifest and symbols_path.exists():
        try:
            for line in symbols_path.read_text(encoding="utf-8").splitlines():
                rec = json.loads(line)
                if "path" in rec:
                    old_symbols[rec["path"]] = rec
        except Exception:
            old_symbols = {}

    files = discover(root)
    stack = detect_stack(root, source_file_count=len(files))
    is_wp = stack["wordpress"] is not None
    psr4_dirs = sorted({p for p in stack.get("psr4", {}).values() if p}, key=len, reverse=True)

    current_paths = {p.relative_to(root).as_posix(): p for p in files}
    old_hashes = old_manifest.get("files", {})
    records: dict[str, Any] = {}
    manifest_files: dict[str, str] = {}

    for rel, path in current_paths.items():
        h = digest(path)
        manifest_files[rel] = h
        if not args.full and old_hashes.get(rel) == h and rel in old_symbols:
            records[rel] = old_symbols[rel]
        else:
            records[rel] = parse(path, rel, is_wp, psr4_dirs)

    # file -> test mapping: match *Test classes and project-namespace imports.
    class_files: dict[str, str] = {}
    for rel, rec in records.items():
        for sym in rec["symbols"]:
            if sym["kind"] in {"class", "interface", "trait", "enum"}:
                class_files.setdefault(sym["name"], rel)
    tested_by: dict[str, set[str]] = defaultdict(set)
    for rel, rec in records.items():
        if rec["responsibility"] != "test":
            continue
        for sym in rec["symbols"]:
            if sym["kind"] == "class" and sym["name"].endswith("Test"):
                target = class_files.get(sym["name"][:-4])
                if target:
                    tested_by[target].add(rel)
        for imp in rec.get("imports", []):
            cls = imp.split()[0].rsplit("\\", 1)[-1]
            target = class_files.get(cls)
            if target and target != rel:
                tested_by[target].add(rel)
    for rel, tests in tested_by.items():
        records[rel]["tested_by"] = sorted(tests)[:10]

    domains: dict[str, list[dict[str, Any]]] = defaultdict(list)
    all_routes = []
    all_hooks = []
    all_relations = []
    for record in records.values():
        domains[record["domain"]].append(record)
        for route in record["routes"]:
            row = {"file": record["path"], **route}
            if route["method"] in WP_ROW_KINDS:
                all_hooks.append(row)
            else:
                all_routes.append(row)
        for relation in record["relations"]:
            all_relations.append({"file": record["path"], **relation})

    # PROJECT_MAP.md is the tier-1 read: stack, domains, entry points, quality
    # gates, legend, and a few key files per domain — most tasks should need
    # only this file plus one DOMAINS/*.md (or an `ai-dev query` call).
    project_map = [
        "# Project Map",
        "",
        f"- Index version: `{VERSION}`",
        f"- Detected stack: `{', '.join(stack_labels(stack))}`",
        f"- Indexed files: `{len(records)}`",
        "",
        "## Domains",
        "",
    ]
    for name in sorted(domains):
        project_map.append(f"- [{name}](DOMAINS/{re.sub(r'[^A-Za-z0-9._-]+', '-', name)}.md): {len(domains[name])} files")

    # Stack-driven entry points.
    entry_candidates: list[str] = []
    if stack["laravel"]:
        entry_candidates += [
            "routes/web.php", "routes/api.php", "routes/console.php",
            "bootstrap/app.php", "bootstrap/providers.php", "app/Http/Kernel.php",
            "resources/js/app.tsx", "resources/js/app.jsx",
        ]
    if stack["symfony"]:
        entry_candidates += ["public/index.php", "src/Kernel.php", "config/bundles.php", "bin/console"]
    if is_wp:
        wp_type = stack["wordpress"]["type"]
        if wp_type == "theme":
            entry_candidates += ["functions.php", "theme.json", "style.css"]
        elif wp_type == "plugin":
            entry_candidates += sorted(
                rel for rel in records
                if "/" not in rel and rel.endswith(".php")
            )[:5] + ["uninstall.php"]
        else:
            entry_candidates += sorted(
                rel for rel in records if rel.startswith("wp-content/mu-plugins/")
            )[:5]
    if not entry_candidates:
        entry_candidates = ["public/index.php", "index.php", "composer.json"]

    project_map += ["", "## Primary entry points", ""]
    for candidate in entry_candidates:
        if candidate in records:
            project_map.append(f"- `{candidate}` — {LEGEND[records[candidate]['responsibility']]}")

    if stack["composer"]:
        gates_line = []
        for tool_key, label in (("testing", "tests"), ("static_analysis", "static analysis"), ("formatter", "formatter")):
            if stack[tool_key] != "none":
                gates_line.append(f"{label}: `{stack[tool_key]}`")
        project_map += ["", "## Quality gates", ""]
        if gates_line:
            project_map.append("- " + " | ".join(gates_line))
        scripts = stack.get("composer_scripts", {})
        for name in ("test", "lint", "analyse", "analyze", "format", "check"):
            if name in scripts:
                project_map.append(f"- `composer {name}` → `{scripts[name]}`")
        if len(project_map) and project_map[-1] == "":
            project_map.append("_No quality tooling detected._")

    project_map += ["", "## Key files per domain", ""]
    priority = {code: i for i, code in enumerate(KEY_FILE_PRIORITY)}
    for name in sorted(domains):
        ranked = sorted(
            (r for r in domains[name] if r["responsibility"] in priority),
            key=lambda r: (priority[r["responsibility"]], r["path"]),
        )[:8]
        if not ranked:
            continue
        project_map.append(f"### {name}")
        for rec in ranked:
            project_map.append(f"- `{rec['path']}` ({rec['responsibility']})")
        project_map.append("")
    project_map += [
        "## Responsibility codes",
        "",
        ", ".join(f"`{code}`={label}" for code, label in sorted(LEGEND.items())),
    ]
    write_if_changed(out / "PROJECT_MAP.md", "\n".join(project_map) + "\n")

    # ROUTES.md — application routes (Laravel/Livewire/Filament).
    rt_rows = runtime_routes(root) if args.runtime else None
    if rt_rows is not None:
        routes_md = "# Routes\n\n_source: `php artisan route:list --json`_\n\n"
        routes_md += markdown_table(
            ["Method", "URI", "Name", "Handler", "Middleware"],
            [[r["method"], r["uri"], r["name"], r["handler"], r["middleware"]] for r in rt_rows],
        )
    else:
        route_rows = [[r["method"], r["uri"], r.get("name", ""), r["handler"], r["file"]] for r in all_routes]
        routes_md = "# Routes\n\n_source: static parse (best-effort group prefixes); run `ai-dev-project-index . --runtime` for artisan ground truth_\n\n"
        routes_md += markdown_table(["Method", "URI", "Name", "Handler", "File"], route_rows) if route_rows else "_No routes detected._"
    write_if_changed(out / "ROUTES.md", routes_md + "\n")

    # HOOKS.md — WordPress hooks, shortcodes, REST routes, CPTs, lifecycle.
    hooks_path = out / "HOOKS.md"
    if all_hooks:
        hook_rows = [[h["method"], h["uri"], h["handler"], h["file"]] for h in all_hooks]
        hooks_md = "# WordPress Hooks & Entry Points\n\nActions, filters, shortcodes, REST routes (`REST`), custom post types (`CPT`), taxonomies, blocks, and lifecycle hooks.\nRows marked `(NO permission_callback)` are publicly accessible REST endpoints — audit them.\n\n"
        hooks_md += markdown_table(["Kind", "Hook/URI", "Handler", "File"], hook_rows)
        write_if_changed(hooks_path, hooks_md + "\n")
    elif hooks_path.exists():
        hooks_path.unlink()

    # SCHEMA.md — folded from migration schema ops in filename order.
    schema_path = out / "SCHEMA.md"
    schema_tables: dict[str, dict[str, Any]] = {}
    for rel in sorted(records):
        for block in records[rel].get("schema", []):
            table = schema_tables.setdefault(block["table"], {"columns": {}, "indexes": [], "files": []})
            for col in block["columns"]:
                table["columns"][col["name"]] = col["type"]
            for idx in block["indexes"]:
                if idx not in table["indexes"]:
                    table["indexes"].append(idx)
            for drop in block["drops"]:
                table["columns"].pop(drop, None)
            if rel not in table["files"]:
                table["files"].append(rel)
    if schema_tables:
        schema_md = ["# Database Schema (from migrations)", "",
                     "_Folded from `database/migrations/**` in filename order. Non-authoritative — verify against real migrations/DB for schema-changing work._", ""]
        for table in sorted(schema_tables):
            info = schema_tables[table]
            cols = ", ".join(f"{n}:{t}" for n, t in info["columns"].items())
            schema_md.append(f"## {table}")
            schema_md.append(f"- columns: {cols or '(none parsed)'}")
            if info["indexes"]:
                schema_md.append(f"- indexes: {', '.join(info['indexes'])}")
            schema_md.append(f"- migrations: {', '.join(info['files'])}")
            schema_md.append("")
        write_if_changed(schema_path, "\n".join(schema_md).rstrip() + "\n")
    elif schema_path.exists():
        schema_path.unlink()

    # FRAMEWORK.md — events, authorization, queues, schedule (on-demand tier).
    framework_path = out / "FRAMEWORK.md"
    fw_sections = []
    event_rows = []
    for rel in sorted(records):
        for r in records[rel]["relations"]:
            if r["kind"] in {"listens", "event"}:
                event_rows.append([r["kind"], r["target"], rel])
    if event_rows:
        fw_sections.append("## Events\n\n" + markdown_table(["Edge", "Event", "File"], event_rows))
    auth_rows = []
    for rel in sorted(records):
        for r in records[rel]["relations"]:
            if r["kind"] == "policy":
                auth_rows.append(["policy", r["target"], rel])
        for gate in records[rel].get("gates", []):
            auth_rows.append(["gate", gate, rel])
    if auth_rows:
        fw_sections.append("## Authorization\n\n" + markdown_table(["Kind", "Mapping", "File"], auth_rows))
    queue_rows = []
    for rel in sorted(records):
        q = records[rel].get("queue")
        if q:
            queue_rows.append([rel, q.get("queue", "default"), "yes" if q.get("unique") else ""])
    if queue_rows:
        fw_sections.append("## Queues\n\n" + markdown_table(["Job file", "Queue", "Unique"], queue_rows))
    schedule_rows = []
    for rel in sorted(records):
        for s in records[rel].get("schedule", []):
            schedule_rows.append([s["kind"], s["target"], s["frequency"], rel])
    if schedule_rows:
        fw_sections.append("## Schedule\n\n" + markdown_table(["Kind", "Target", "Frequency", "File"], schedule_rows))
    if fw_sections:
        write_if_changed(framework_path, "# Framework Map\n\n" + "\n\n".join(fw_sections) + "\n")
    elif framework_path.exists():
        framework_path.unlink()

    # FILES.md is a compact path -> domain map; per-file symbols live in
    # DOMAINS/*.md and SYMBOLS.jsonl instead of being duplicated here.
    files_md = ["# Files", "", "Responsibility codes: see PROJECT_MAP.md.", ""]
    for name in sorted(domains):
        files_md.append(f"## {name} ({len(domains[name])})")
        for rec in sorted(domains[name], key=lambda r: r["path"]):
            files_md.append(f"- {rec['path']} ({rec['responsibility']})")
        files_md.append("")
    write_if_changed(out / "FILES.md", "\n".join(files_md).rstrip() + "\n")

    is_internal = internal_import_filter(records)
    relation_rows = []
    for rel in sorted(records):
        rec = records[rel]
        internal_imports = [imp for imp in rec["imports"] if is_internal(imp)]
        for imp in internal_imports[:20]:
            relation_rows.append([rel, "import", imp])
        for relation in rec["relations"]:
            relation_rows.append([rel, relation["type"], relation["target"]])
        for table in rec["tables"]:
            relation_rows.append([rel, "table", table])
    relations_md = "# Relationships\n\nProject-internal imports only; full import lists live in SYMBOLS.jsonl.\n\n"
    relations_md += markdown_table(["Source", "Relation", "Target"], relation_rows) if relation_rows else "_No relationships detected._"
    write_if_changed(out / "RELATIONS.md", relations_md + "\n")

    DOMAIN_ROW_CAP = 100
    existing_domain_files = set(domains_dir.glob("*.md"))
    generated_domain_files = set()
    for name, items in sorted(domains.items()):
        safe = re.sub(r"[^A-Za-z0-9._-]+", "-", name)
        dest = domains_dir / f"{safe}.md"
        generated_domain_files.add(dest)
        rows = []
        ranked = sorted(items, key=lambda x: x["path"])
        for rec in ranked[:DOMAIN_ROW_CAP]:
            rows.append([
                rec["path"],
                rec["responsibility"],
                ", ".join(s["name"] for s in rec["symbols"][:10]),
            ])
        body = (
            f"# Domain: {name}\n\nResponsibility codes: see PROJECT_MAP.md.\n\n"
            + markdown_table(["File", "Resp", "Symbols"], rows)
        )
        if len(ranked) > DOMAIN_ROW_CAP:
            body += f"\n\n_{len(ranked) - DOMAIN_ROW_CAP} more files — run `ai-dev query domain {name}` or grep `SYMBOLS.jsonl`._"
        write_if_changed(dest, body + "\n")
    for stale in existing_domain_files - generated_domain_files:
        stale.unlink()

    # One compact JSON record per line so exact lookups are a single-line
    # grep instead of a whole-file read.
    symbol_lines = [json.dumps({"version": VERSION, "files": len(records)}, ensure_ascii=False, separators=(",", ":"))]
    for rel in sorted(records):
        symbol_lines.append(json.dumps(records[rel], ensure_ascii=False, separators=(",", ":")))
    write_if_changed(symbols_path, "\n".join(symbol_lines) + "\n")
    if legacy_symbols_path.exists():
        legacy_symbols_path.unlink()

    manifest = {
        "version": VERSION,
        "stack": stack,
        "files": manifest_files,
    }
    write_if_changed(manifest_path, json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True))

    last_run_path = out / "last-run.json"
    if last_run_path.exists():
        last_run_path.unlink()

    print(f"Project index: {out}")
    print(f"Indexed: {len(records)} files ({', '.join(stack_labels(stack))})")


if __name__ == "__main__":
    main()
