#!/usr/bin/env bash
set -euo pipefail

PROJECT="${1:-.}"
PROJECT="$(cd "$PROJECT" && pwd)"
GLOBAL_HOME="${AI_DEV_KIT_HOME:-$HOME/.local/share/ai-dev-kit}"

mkdir -p \
  "$PROJECT/.ai/project-index/DOMAINS" \
  "$PROJECT/.cursor/rules" \
  "$PROJECT/.github" \
  "$PROJECT/.specify/memory"

write_if_missing() {
  local target="$1"
  if [[ -e "$target" ]]; then
    return 0
  fi
  mkdir -p "$(dirname "$target")"
  cat > "$target"
}

write_if_missing "$PROJECT/.cursor/rules/00-project-index-first.mdc" <<'EOF'
---
description: Always consult and maintain the project-local intelligence index first
alwaysApply: true
---
Before broad repository exploration, run `ai-dev .`.
Read `.ai/project-index/PROJECT_MAP.md` (stack, domains, entry points, key files), then only the one relevant `DOMAINS/<domain>.md` — most tasks need nothing else.
For exact class/method/route lookups, grep one line from `SYMBOLS.jsonl` (one JSON record per file), e.g. `grep '"UserController"' .ai/project-index/SYMBOLS.jsonl` — never read it whole.
`ROUTES.md`, `RELATIONS.md`, and `FILES.md` are on-demand only: routing questions, dependency tracing, or a full file inventory. Do not read them by default.
Use the map to choose the smallest relevant source set.
Open real source files when the map is incomplete, stale, uncertain, sensitive, or the code will be changed.
After source changes, run `ai-dev .` again.
The index is not authoritative for security, payments, authorization, migrations, concurrency, or production incidents.
EOF

write_if_missing "$PROJECT/.github/copilot-instructions.md" <<'EOF'
# Project Intelligence First

Before broad searching or reading, run `ai-dev .`.

Read the project-local index tiered — stop as soon as you know where to work:
1. `.ai/project-index/PROJECT_MAP.md` — stack, domains, entry points, key files. Often enough on its own.
2. The one relevant `.ai/project-index/DOMAINS/<domain>.md`.
3. Exact symbol/route lookups: grep a single line from `.ai/project-index/SYMBOLS.jsonl` (one JSON record per file) — never read it whole.
4. On demand only: `ROUTES.md` (routing questions), `RELATIONS.md` (dependency tracing), `FILES.md` (full inventory).

Use it to identify the smallest relevant set of real files. Verify source when data is missing, stale, uncertain, sensitive, or being modified. Refresh the index after code changes.
EOF

write_if_missing "$PROJECT/CLAUDE.md" <<'EOF'
# Mandatory Project Intelligence Workflow

At the beginning of every task, run:

```bash
ai-dev .
```

Always inspect `.ai/project-index/` before broad repository exploration, tiered: read `PROJECT_MAP.md` (stack, domains, entry points, key files), then only the one relevant `DOMAINS/<domain>.md`. For exact class/method/route lookups, grep a single line from `SYMBOLS.jsonl` (one JSON record per file) instead of re-reading source — never read it whole. `ROUTES.md`, `RELATIONS.md`, and `FILES.md` are on-demand only (routing questions, dependency tracing, full inventory) — do not read them by default. Verify real source for sensitive or changed logic. Re-run the indexer after modifications.
EOF

write_if_missing "$PROJECT/AGENTS.md" <<'EOF'
# Agent Instructions

All coding agents must use the project-local index first — tiered, stopping as soon as the work is located.

1. Run `ai-dev .`.
2. Read `.ai/project-index/PROJECT_MAP.md` (stack, domains, entry points, key files) — often enough on its own.
3. Read only the one relevant `.ai/project-index/DOMAINS/<domain>.md`.
4. For exact class/method/route lookups, grep a single line from `.ai/project-index/SYMBOLS.jsonl` (one JSON record per file) — never read it whole.
5. On demand only: `ROUTES.md` (routing questions), `RELATIONS.md` (dependency tracing), `FILES.md` (full inventory).
6. Open only the required source files.
7. Verify sensitive logic directly.
8. Refresh the index after source changes.
EOF

write_if_missing "$PROJECT/.specify/memory/project-index.md" <<'EOF'
# Project Index Integration

Specifications, plans, and implementation tasks must consult the canonical project map at:

```text
.ai/project-index/
```

Before creating or updating a specification:
- refresh the index with `ai-dev-project-index .`;
- inspect `PROJECT_MAP.md` (stack, domains, entry points, key files), then only the relevant `DOMAINS/<domain>.md`;
- reference exact file paths and symbols, grepping single lines from `SYMBOLS.jsonl` (one JSON record per file) instead of re-reading source;
- consult `ROUTES.md`, `RELATIONS.md`, or `FILES.md` only when the spec needs routing, dependency, or full-inventory detail;
- mark inferred information as inferred;
- verify sensitive flows against current source.
EOF

write_if_missing "$PROJECT/.ai/project-index/README.md" <<'EOF'
# Project Intelligence Index

Generated and incrementally maintained by `ai-dev-project-index`.

This folder is intentionally stored inside the project so Cursor, VS Code/Copilot, Claude Code, and specification workflows can reuse the same map.

Do not edit generated files manually. Rebuild with:

```bash
ai-dev-project-index .
```
EOF

printf 'Project AI integration initialized:\n'
printf '  Cursor: .cursor/rules/00-project-index-first.mdc\n'
printf '  VS Code/Copilot: .github/copilot-instructions.md\n'
printf '  Claude Code: CLAUDE.md\n'
printf '  Generic agents: AGENTS.md\n'
printf '  Specify: .specify/memory/project-index.md\n'
printf '  Index: .ai/project-index/\n'
