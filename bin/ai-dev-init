#!/usr/bin/env bash
set -euo pipefail

# ai-dev-init [project] [--update] [--editors=a,b] [--all-editors] [--list-editors]
#
# Scaffolds the cross-tool adapter files. Kit-owned content lives inside a
# managed block (between the ai-dev-kit:begin/end markers); everything a
# project adds outside the block is preserved forever. With --update,
# pre-marker legacy files are migrated: pristine kit copies (recognized by
# hash) are replaced, edited ones get the managed block appended below the
# project's own content.
#
# AGENTS.md (canonical) and CLAUDE.md are always written. Every other editor
# adapter is seeded when that editor is detected in the project, remembered in
# .ai/editors, or named explicitly via --editors / --all-editors.

UPDATE=0
ALL_EDITORS=0
REQUESTED=""
PROJECT="."
for arg in "$@"; do
  case "$arg" in
    --update) UPDATE=1 ;;
    --all-editors) ALL_EDITORS=1 ;;
    --editors=*|--editor=*) REQUESTED="$REQUESTED $(printf '%s' "${arg#*=}" | tr ',' ' ')" ;;
    --list-editors) LIST_EDITORS=1 ;;
    *) PROJECT="$arg" ;;
  esac
done

# ---- cross-editor adapter registry ---------------------------------------
# name|adapter path|space-separated detection markers|frontmatter style
# Detection markers are the directories/files an editor creates for its own
# config; when one exists the project already uses that editor, so its adapter
# is seeded. `-` means the adapter is plain Markdown with no frontmatter.
EDITORS='kilo|.kilo/rules/00-ai-dev-kit.md|.kilo kilo.jsonc|-
kilocode|.kilocode/rules/00-ai-dev-kit.md|.kilocode .kilocoderules|-
windsurf|.windsurf/rules/ai-dev-kit.md|.windsurf .windsurfrules|trigger
devin|.devin/rules/ai-dev-kit.md|.devin|trigger
antigravity|.agents/rules/ai-dev-kit.md|.agents .agent|-
roo|.roo/rules/00-ai-dev-kit.md|.roo .roorules|-
cline|.clinerules/00-ai-dev-kit.md|.clinerules|-
continue|.continue/rules/ai-dev-kit.md|.continue|always
trae|.trae/rules/project_rules.md|.trae|-
junie|.junie/guidelines.md|.junie|-
zed|.rules|.zed .rules|-
gemini|GEMINI.md|.gemini GEMINI.md|-
aider|CONVENTIONS.md|.aider.conf.yml .aider.conf.yaml|-
copilot|.github/copilot-instructions.md|.github|-
specify|.specify/memory/project-index.md|.specify|-'

editor_names() { printf '%s\n' "$EDITORS" | cut -d'|' -f1; }

editor_field() {  # $1=name  $2=field number (2=path, 3=markers, 4=frontmatter)
  printf '%s\n' "$EDITORS" | awk -F'|' -v n="$1" -v f="$2" '$1 == n { print $f; exit }'
}

if [ "${LIST_EDITORS:-0}" -eq 1 ]; then
  printf 'Editors supported by ai-dev-init (always on: AGENTS.md, CLAUDE.md):\n'
  printf '%s\n' "$EDITORS" | awk -F'|' '{ printf "  %-12s %-34s detected via: %s\n", $1, $2, $3 }'
  exit 0
fi

PROJECT="$(cd "$PROJECT" && pwd)"

BEGIN_MARK='<!-- ai-dev-kit:begin — managed block, updated automatically; add customizations outside it -->'
END_MARK='<!-- ai-dev-kit:end -->'

# sha256 of every pristine adapter body ever shipped before managed blocks
# existed (extracted from the full git history of this script and the
# indexer's README seeding). Frozen: markers carry all future updates.
LEGACY_HASHES="\
04b1547eb367795af869f3e5b5ade95b98177d8110c62c61107ac5cf58149fb7 \
adecb8fa139985ba773e87f62cbd41238f49e5ca116b00b77471dcf718ad83d2 \
1fcafb4eb3aa489d3d92667936783e3b1ec4b8aff327359d27decddb03cd50fb \
24c592832c180676cdda8d0ebb2ac03244c415b2f5c8ed65e0b1a85308336721 \
16a5ce97eb5adae8c180211c563c64c38d0980de08710949fbc7401739ee4581 \
60603e188c1936eab92280fc500ebb27182d4ff0b05bc07a86ffcc9eb68a6963 \
6fff90ab8542eda0dc05ede07e2a412d9ff61c73752e9ee3daa8b35d15e9cdc0 \
ed554ec8600a18a9d2afd89a84ad642ba172119d3f40bfccfa0b7693efde5e96 \
6d840ec858d544ba14b6fc54df0511941f7145408d9d2c8c869697b78259773f \
b7d52a18f1394edfda454ca00ad4002e5b926cc0a41ddd3b1789dca76d5e6d69 \
231b2a85fd26a415f5e296ccb95f0e063f9abe40108a53613305e7f56f6a29d6 \
c5a5b121e4ad954bb37d5bd3aa9eb7638e2e20e77540cadb95582c14c6ad9ba6 \
c43a52ed85032109b88fc6ecf39ed78cfefc7d5709b86129aae5db1f3cb96525 \
ac4a83a892d446989104ad80a1688f494f2217216f90fac4c0b7f9d5e670f84a \
2ba918b3ae168af3f73a49cb025b994d10229444e6aa9aab94ff72593beb8ec5 \
448e4e514ba426b84ecd0e273add5d7106ef59c09821a5634307631ff3c7427d \
3089cf04e92e7bb2808bcad87ec9f2f876bb0b1c97fcadd21d6655bd6480aad9"

NOTICES=""

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

is_legacy() {
  case " $LEGACY_HASHES " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

replace_block() {  # $1=file  $2=replacement block; prints the rewritten file
  local file="$1" block="$2" out="" in_block=0 line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *'ai-dev-kit:begin'*)
        in_block=1
        out="${out}${block}"$'\n'
        ;;
      *'ai-dev-kit:end'*)
        in_block=0
        ;;
      *)
        if [ "$in_block" -eq 0 ]; then
          out="${out}${line}"$'\n'
        fi
        ;;
    esac
  done < "$file"
  printf '%s' "$out"
}

write_managed() {  # $1=target  $2=optional frontmatter (creation only); kit body on stdin
  local target="$1" header="${2:-}" body block
  body="$(cat)"
  block="${BEGIN_MARK}"$'\n'"${body}"$'\n'"${END_MARK}"

  if [[ ! -e "$target" ]]; then
    mkdir -p "$(dirname "$target")"
    if [[ -n "$header" ]]; then
      printf '%s\n%s\n' "$header" "$block" > "$target"
    else
      printf '%s\n' "$block" > "$target"
    fi
    return 0
  fi

  if grep -q 'ai-dev-kit:begin' "$target" && grep -q 'ai-dev-kit:end' "$target"; then
    local new
    new="$(replace_block "$target" "$block")"
    if [ "$new" != "$(cat "$target")" ]; then
      printf '%s\n' "$new" > "$target"
    fi
    return 0
  fi

  # Unmarked pre-1.4 file. Plain runs keep the old skip-if-exists behavior;
  # --update migrates it.
  if [[ "$UPDATE" -eq 1 ]]; then
    if is_legacy "$(hash_file "$target")"; then
      printf '%s\n' "$block" > "$target"
    else
      printf '\n%s\n' "$block" >> "$target"
      NOTICES="${NOTICES}  $target: pre-existing content kept above the new ai-dev-kit block — review for duplicated instructions"$'\n'
    fi
  fi
  return 0
}

write_generated() {  # $1=target; kit-owned generated file, refreshed when it differs
  local target="$1" body
  body="$(cat)"
  if [[ -e "$target" ]] && [ "$body" = "$(cat "$target")" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$target")"
  printf '%s\n' "$body" > "$target"
}

# Every adapter carries the same short pointer to AGENTS.md (the canonical
# protocol) and to `.ai/rules/` (the one shared rule set), so the always-on
# context stays tiny and nothing is duplicated per editor. copilot and specify
# keep their historical longer bodies.

adapter_frontmatter() {  # $1=frontmatter style from the registry
  case "$1" in
    trigger) printf -- '---\ntrigger: always_on\ndescription: Index-first project workflow (ai-dev-kit)\n---' ;;
    always)  printf -- '---\nname: Project index-first workflow\nalwaysApply: true\n---' ;;
    *) : ;;
  esac
}

adapter_body() {  # $1=editor name
  case "$1" in
    copilot)
      cat <<'EOF'
# Project Intelligence First

Before broad searching or reading, run `ai-dev .`.

Locate work tiered — stop as soon as you know where to work:
1. `ai-dev query <symbol|route|file|domain> <term>` — exact lookups in a few lines.
2. `.ai/project-index/PROJECT_MAP.md` — stack, domains, entry points, key files.
3. The one relevant `.ai/project-index/DOMAINS/<domain>.md`.
4. On demand only: `ROUTES.md`, `SCHEMA.md`, `FRAMEWORK.md`, `RELATIONS.md`, `FILES.md`.

Open only the smallest relevant set of real files. Verify security, payments, authorization, and migration logic directly in source. Refresh the index after code changes (`ai-dev .`).
EOF
      ;;
    specify)
      cat <<'EOF'
# Project Index Integration

Specifications, plans, and tasks must consult `.ai/project-index/` (the canonical project map). Follow `AGENTS.md` at the repository root: run `ai-dev .` first, use `ai-dev query` and tiered index reads, reference exact file paths and symbols, mark inferred information as inferred, and verify sensitive flows against current source.
EOF
      ;;
    *)
      cat <<'EOF'
# Project AI Workflow

At the start of every task, run `ai-dev .`, then read and follow `AGENTS.md` — the canonical index-first instructions (`ai-dev query` lookups, tiered reads of `.ai/project-index/`).

Project rules live in `.ai/rules/` — one shared set for every editor, not a per-editor copy. Read `.ai/rules/00-core/` before starting, then only the topical directories matching what you touch (`10-laravel/`, `20-database/`, `40-security/`, `60-testing/`, `65-domain/<domain>/`, …).
EOF
      ;;
  esac
}

mkdir -p "$PROJECT/.ai/project-index/DOMAINS"

write_managed "$PROJECT/AGENTS.md" <<'EOF'
# Agent Instructions

At the start of every task, run `ai-dev .` (initializes adapters, refreshes the index, syncs rules; safe, idempotent, auto-applies kit updates).

Locate work through the project index — tiered, stopping as soon as the work is located:
1. `ai-dev query map` — stack, tooling, domains.
2. `ai-dev query symbol|route|hook|file|domain|table|env <term>` — exact lookups answered in a few lines.
3. `ai-dev query api <Class|domain>` — **every public method's full signature, line range, and summary, without reading any file.** Use this before calling or modifying code; do not open a file just to learn a signature.
4. `ai-dev query snippet <Class::method>` — **only the lines that symbol occupies.** Never read a whole file for one method.
5. `ai-dev query callers <Class::method>` — every file that calls it, for edit-impact before changing a signature.
6. `.ai/project-index/PROJECT_MAP.md`, then the one relevant `DOMAINS/<domain>.md`.
7. Grep a single line from `SYMBOLS.jsonl` for anything the above doesn't answer — never read it whole.
8. On demand only: `ROUTES.md` (routing), `SCHEMA.md` (database schema), `FRAMEWORK.md` (events, policies, queues, schedule), `HOOKS.md` (WordPress hooks), `RELATIONS.md` (dependency tracing), `FILES.md` (full inventory).

Project rules live in `.ai/rules/` — one shared set every editor reads (Cursor sees it through the `.cursor/rules` symlink). Read `.ai/rules/00-core/` at task start and the topical directories matching what you touch; never copy rules into an editor-specific folder.

Keep every change proportional to the request: edit in place with targeted replacements, never rewrite a whole file to change part of it, do not create new files (or README/summary/notes files) for small work, and make no drive-by renames, reformatting, or refactors in code you were not asked to touch. Review the final diff — every changed line must trace to the request.

Open a full source file only when you are about to change it, or when the index is missing detail. The index is never authoritative for security, payments, authorization, tenancy, concurrency, migrations, destructive operations, or production incidents — verify those directly in source. Refresh with `ai-dev .` after source changes.
EOF

adapter_body claude | write_managed "$PROJECT/CLAUDE.md"

# ---- editor adapters ------------------------------------------------------
known_editor() { editor_names | grep -qx "$1"; }

PINNED=""    # remembered in .ai/editors — seeded whether or not the editor is detected
SELECTED=""  # pinned + auto-detected

add_to() {  # $1=name of the list variable  $2=editor to append once
  local current="${!1}"
  case " $current " in
    *" $2 "*) return 0 ;;
  esac
  eval "$1=\"\$current \$2\""
}

pin_editor() {
  if ! known_editor "$1"; then
    printf 'warning: unknown editor %s (see: ai-dev-init --list-editors)\n' "$1" >&2
    return 0
  fi
  add_to PINNED "$1"
  add_to SELECTED "$1"
}

EDITORS_FILE="$PROJECT/.ai/editors"
if [[ -f "$EDITORS_FILE" ]]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="$(printf '%s' "${line%%#*}" | tr -d '[:space:]')"
    [ -n "$line" ] && pin_editor "$line"
  done < "$EDITORS_FILE"
fi

for name in $REQUESTED; do pin_editor "$name"; done

if [[ "$ALL_EDITORS" -eq 1 ]]; then
  while IFS= read -r name; do pin_editor "$name"; done < <(editor_names)
fi

# Auto-detect: an editor's own config directory/file in the project means the
# project already uses it, so seed its adapter without pinning the choice.
while IFS= read -r name; do
  for marker in $(editor_field "$name" 3); do
    if [[ -e "$PROJECT/$marker" ]]; then
      add_to SELECTED "$name"
      break
    fi
  done
done < <(editor_names)

if [[ -n "$REQUESTED" || "$ALL_EDITORS" -eq 1 ]]; then
  mkdir -p "$PROJECT/.ai"
  {
    printf '# Editor adapters ai-dev-init keeps in this project (ai-dev-init --list-editors).\n'
    printf '# Detected editors are seeded automatically and need no entry here.\n'
    for name in $PINNED; do printf '%s\n' "$name"; done
  } > "$EDITORS_FILE"
fi

SEEDED=""
for name in $SELECTED; do
  target="$(editor_field "$name" 2)"
  style="$(editor_field "$name" 4)"
  # .clinerules ships as either a single root file or a directory of rules.
  if [[ "$name" = cline && -f "$PROJECT/.clinerules" ]]; then
    target=".clinerules"
    style="-"
  fi
  adapter_body "$name" | write_managed "$PROJECT/$target" "$(adapter_frontmatter "$style")"
  SEEDED="${SEEDED}  ${name}: ${target}"$'\n'
done

# Kilo only loads .kilo/rules/*.md when kilo.jsonc lists it under "instructions"
# (.kilocode/rules/ is auto-included for backward compatibility).
case " $SELECTED " in
  *" kilo "*)
    KILO_CONFIG="$PROJECT/kilo.jsonc"
    if [[ ! -e "$KILO_CONFIG" ]]; then
      cat > "$KILO_CONFIG" <<'EOF'
{
  // Kilo Code project configuration. Files listed under "instructions" are
  // loaded into every task; add your own globs alongside the ai-dev-kit one.
  "instructions": [".kilo/rules/*.md"]
}
EOF
    elif ! grep -q '\.kilo/rules' "$KILO_CONFIG"; then
      NOTICES="${NOTICES}  kilo.jsonc: add \".kilo/rules/*.md\" to \"instructions\" so Kilo loads the seeded rule"$'\n'
    fi
    ;;
esac

write_generated "$PROJECT/.ai/project-index/README.md" <<'EOF'
# Project Intelligence Index

Generated and incrementally maintained by `ai-dev-project-index` (ai-dev-kit).

Shared by Cursor, VS Code/Copilot, Claude Code, and spec workflows so every tool reuses the same map. Do not edit generated files manually. Rebuild with `ai-dev-project-index .` (force a full re-parse with `--full`).
EOF

# The index-first Cursor rule is owned by ai-dev-project-rules since kit 1.4.0
# (00-core/project-navigation.mdc). Remove the retired init-seeded copy when
# it is still a pristine kit version; edited copies are left alone.
LEGACY_MDC="$PROJECT/.cursor/rules/00-project-index-first.mdc"
if [[ "$UPDATE" -eq 1 && -f "$LEGACY_MDC" ]] && is_legacy "$(hash_file "$LEGACY_MDC")"; then
  rm "$LEGACY_MDC"
fi

printf 'Project AI integration initialized:\n'
printf '  Canonical protocol: AGENTS.md (managed block)\n'
printf '  Claude Code: CLAUDE.md -> AGENTS.md\n'
if [[ -n "$SEEDED" ]]; then
  printf 'Editor adapters (-> AGENTS.md):\n%s' "$SEEDED"
fi
printf '  Index: .ai/project-index/\n'
if [[ -n "$NOTICES" ]]; then
  printf 'Migration notices:\n%s' "$NOTICES"
fi
